#!/usr/bin/env bash
# Clean Sweep password reminder (Job 3 Step 8e): runs at login after a System Reset or Full Wipe.
# Asks the user to choose a new password; it comes back every login until they click Yes.
set -uo pipefail

TITLE="ForgeOS Clean Sweep"
AUTOSTART="$HOME/.config/autostart/forgeos-password-reminder.desktop"
TEXT="Clean Sweep reset this PC. To be safe, choose a new password now — whoever got in may know your old one.

Open the password settings now?"

answer=1
if command -v kdialog >/dev/null 2>&1; then
    kdialog --title "$TITLE" --yesno "$TEXT"
    answer=$?
elif command -v zenity >/dev/null 2>&1; then
    zenity --question --title="$TITLE" --text="$TEXT"
    answer=$?
fi

if [ "$answer" -eq 0 ]; then
    rm -f -- "$AUTOSTART"
    systemsettings kcm_users || kcmshell6 kcm_users || true
fi
exit 0
