#!/usr/bin/env bash
# Clean Sweep window (Steps 7a-7b): main menu with Scan Now, System Reset and Full Wipe.
set -uo pipefail

TITLE="ForgeOS Clean Sweep"
ENGINE="/usr/bin/forgeos-cleansweep"

# Return 0 when a graphical session (X or Wayland) is available.
has_gui() {
    [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]]
}

# Ask a yes/no question via kdialog, zenity, or the terminal.
ask_yes_no() {
    local answer
    if has_gui && command -v kdialog >/dev/null 2>&1; then
        kdialog --title "$TITLE" --warningyesno "$1"
        return $?
    elif has_gui && command -v zenity >/dev/null 2>&1; then
        zenity --question --title="$TITLE" --text="$1"
        return $?
    else
        printf "%s [y/N] " "$1" >&2
        IFS= read -r answer || answer=""
        if [[ "$answer" == [yY]* ]]; then
            return 0
        fi
        return 1
    fi
}

# Show an info or error message via kdialog, zenity, or the terminal.
say() {
    local kind="$1" text="$2"
    if has_gui && command -v kdialog >/dev/null 2>&1; then
        if [[ "$kind" == "info" ]]; then
            kdialog --title "$TITLE" --msgbox "$text" || true
        else
            kdialog --title "$TITLE" --error "$text" || true
        fi
    elif has_gui && command -v zenity >/dev/null 2>&1; then
        if [[ "$kind" == "info" ]]; then
            zenity --info --title="$TITLE" --text="$text" || true
        else
            zenity --error --title="$TITLE" --text="$text" || true
        fi
    elif [[ "$kind" == "info" ]]; then
        echo "$text"
    else
        echo "$text" >&2
    fi
}

# Show the main menu and print one word (scan/reset/wipe) on stdout, or nothing if cancelled.
pick_action() {
    local choice=""
    if has_gui && command -v kdialog >/dev/null 2>&1; then
        choice="$(kdialog --title "$TITLE" --menu "What do you want to do?" scan "Scan Now — check for viruses and hacking tools" reset "System Reset — put ForgeOS back to factory, keep your files" wipe "Full Wipe — erase EVERYTHING and start fresh")" || true
    elif has_gui && command -v zenity >/dev/null 2>&1; then
        choice="$(zenity --list --title="$TITLE" --text="What do you want to do?" --column=Tag --column=Action --hide-column=1 --print-column=1 --height=300 --width=520 scan "Scan Now — check for viruses and hacking tools" reset "System Reset — put ForgeOS back to factory, keep your files" wipe "Full Wipe — erase EVERYTHING and start fresh")" || true
    else
        # Menu + prompt go to stderr: stdout is captured by main as the answer.
        {
            echo "1) Scan Now — check for viruses and hacking tools"
            echo "2) System Reset — put ForgeOS back to factory, keep your files"
            echo "3) Full Wipe — erase EVERYTHING and start fresh"
            printf "Choose 1-3 (Enter to quit): "
        } >&2
        read -r choice || return 0
        case "$choice" in
            1) choice="scan" ;;
            2) choice="reset" ;;
            3) choice="wipe" ;;
            *) return 0 ;;
        esac
    fi
    if [[ -n "$choice" ]]; then
        printf '%s\n' "$choice"
    fi
    return 0
}

# Run the scan engine and report the result to the user.
run_scan() {
    local ref="" rc=0
    if has_gui && command -v kdialog >/dev/null 2>&1; then
        ref="$(kdialog --title "$TITLE" --progressbar "Scanning your PC — this can take a while..." 0)" || ref=""
    fi
    pkexec "$ENGINE" scan
    rc=$?
    if [[ -n "$ref" ]]; then
        dbus-send --session --type=method_call --dest="${ref% *}" "${ref#* }" org.kde.kdialog.ProgressDialog.close >/dev/null 2>&1 || true
    fi
    case "$rc" in
        0) say info "No threats found. Your PC looks clean." ;;
        1) say info "Clean Sweep found threats and locked them away in quarantine. They can't run anymore.

Full report: ~/.local/state/forgeos/clean-sweep/last-report.txt" ;;
        2) say error "Clean Sweep found signs that the system itself was changed. System Reset is recommended.

Full report: ~/.local/state/forgeos/clean-sweep/last-report.txt" ;;
        126) return 0 ;;   # password box closed — the user changed their mind
        127) say error "Your account is not allowed to run Clean Sweep. Sign in as an administrator and try again." ;;
        *) say error "Clean Sweep could not finish the scan. Details are in /var/log/forgeos/clean-sweep/." ;;
    esac
    return 0
}

# Ask the user to type WIPE; print what they typed on stdout (nothing if cancelled).
ask_wipe_word() {
    local word=""
    if has_gui && command -v kdialog >/dev/null 2>&1; then
        word="$(kdialog --title "$TITLE" --inputbox "Type WIPE (capital letters) to erase everything:" "")" || true
    elif has_gui && command -v zenity >/dev/null 2>&1; then
        word="$(zenity --entry --title="$TITLE" --text="Type WIPE (capital letters) to erase everything:")" || true
    else
        printf "Type WIPE (capital letters) to erase everything: " >&2
        read -r word || word=""
    fi
    if [[ -n "$word" ]]; then
        printf '%s\n' "$word"
    fi
    return 0
}

# Offer to restart now; reboot on yes.
offer_restart() {
    if ask_yes_no "$1"; then
        systemctl reboot || say error "Could not restart. Please restart the computer yourself."
    fi
    return 0
}

# Run the engine via pkexec under a busy bar (text in $1, engine args after); print nothing, return the engine exit code.
run_engine() {
    local ref="" rc=0
    if has_gui && command -v kdialog >/dev/null 2>&1; then
        ref="$(kdialog --title "$TITLE" --progressbar "$1" 0)" || ref=""
    fi
    shift
    pkexec "$ENGINE" "$@"
    rc=$?
    if [[ -n "$ref" ]]; then
        dbus-send --session --type=method_call --dest="${ref% *}" "${ref#* }" org.kde.kdialog.ProgressDialog.close >/dev/null 2>&1 || true
    fi
    return "$rc"
}

# System Reset button: confirm, run reset-system --yes, report, offer restart.
run_reset() {
    ask_yes_no "System Reset will:

• Put ForgeOS back to factory settings
• Remove added programs, hidden auto-start items and remote-access keys
• Check your apps and download a fresh signed system
• Ask you to choose a new password after the restart

Your personal files are KEPT. Anything removed is saved in a backup folder.

Continue?" || return 0
    local rc=0
    run_engine "Resetting your PC — this can take a while..." reset-system --yes || rc=$?
    case "$rc" in
        0) offer_restart "System Reset finished. Restart now to complete it?" ;;
        3) say error "System Reset finished with some problems. Details are in /var/log/forgeos/clean-sweep/."
           offer_restart "Restart now anyway?" ;;
        126) return 0 ;;
        127) say error "Your account is not allowed to run Clean Sweep. Sign in as an administrator and try again." ;;
        *) say error "System Reset could not finish. Details are in /var/log/forgeos/clean-sweep/." ;;
    esac
    return 0
}

# Full Wipe button: two confirmations (yes + type WIPE), run full-wipe --yes WIPE, report, offer restart.
run_wipe() {
    ask_yes_no "Full Wipe will ERASE ALL personal files for every user — documents, photos, downloads, everything — and then reset ForgeOS to factory.

This cannot be undone. Back up anything you want to keep first.
After the restart you will be asked to choose a new password.

Continue?" || return 0
    local word rc=0
    word="$(ask_wipe_word)"
    if [[ "$word" != "WIPE" ]]; then
        say info "Full Wipe cancelled. Nothing was changed."
        return 0
    fi
    run_engine "Wiping your PC — this can take a while..." full-wipe --yes WIPE || rc=$?
    case "$rc" in
        0) offer_restart "Full Wipe finished. Restart now to complete it?" ;;
        3) say error "Full Wipe finished with some problems. Details are in /var/log/forgeos/clean-sweep/."
           offer_restart "Restart now anyway?" ;;
        126) return 0 ;;
        127) say error "Your account is not allowed to run Clean Sweep. Sign in as an administrator and try again." ;;
        *) say error "Full Wipe could not finish. Details are in /var/log/forgeos/clean-sweep/." ;;
    esac
    return 0
}

# Show the menu, dispatch the chosen action, and exit cleanly.
main() {
    local action
    action="$(pick_action)"
    case "$action" in
        scan) run_scan ;;
        reset) run_reset ;;
        wipe) run_wipe ;;
        *) exit 0 ;;
    esac
    exit 0
}

main "$@"
