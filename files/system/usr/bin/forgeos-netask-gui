#!/usr/bin/env bash
# ForgeOS "Who Uses the Internet" window (Job 24, Ask Before Connecting), a kdialog front end for forgeos-netask.
# Every app with Allowed / Blocked / Asks each time (change any of them), Today, "Something stopped working?",
# Lock down, Advanced view, and the on/off switch. Anything that lets more through is double-checked by a
# question the PC itself shows, so no program can allow itself.
set -uo pipefail
TITLE="Who Uses the Internet"
ENGINE="${FORGEOS_NETASK_ENGINE:-/usr/bin/forgeos-netask}"
TAB=$'\t'
NL=$'\n'

if ! command -v kdialog >/dev/null 2>&1; then
  echo "kdialog is needed for this window. Use forgeos-netask in a terminal." >&2
  exit 3
fi
[ $# -eq 0 ] || { echo "usage: forgeos-netask-gui" >&2; exit 3; }

info() { kdialog --title "$TITLE" --msgbox "$1" || true; }
say() { kdialog --title "$TITLE" --passivepopup "$1" 8 >/dev/null 2>&1 & }
plain() { grep -v "$TAB" <<< "$1"; }
word() { case "$1" in allow) echo "Allowed" ;; block) echo "Blocked" ;; *) echo "Asks each time" ;; esac; }

one_app() { # KEY NAME ANSWER RED
  local key="$1" name="$2" now="$3" red="$4" pick out
  local -a items=(allow "Allow - may always use the internet" block "Block - never" ask "Ask me each time" what "What is this?")
  [ "$red" != "-" ] && items=(block "Block - never" ask "Ask me each time" what "What is this?")
  pick="$(kdialog --title "$TITLE" --menu "${name}: $(word "$now") now.${NL}${red/#-/}" "${items[@]}")" || return 0
  case "$pick" in
    what) info "$("$ENGINE" explain "$name" 2>/dev/null)" ;;
    allow|block|ask) out="$("$ENGINE" "$pick" "$key" 2>/dev/null)"; say "${out:-That did not work.}" ;;
  esac
}

today() {
  local out
  out="$("$ENGINE" today 2>/dev/null)" || { info "$(plain "$out")"; return 0; }
  info "Today (how many times each app went online - counts only, no web addresses):${NL}${NL}$(awk -F"$TAB" '$1 == "TODAY" { printf "%s: %s\n", $2, $3 }' <<< "$out")$(plain "$out")"
}

undo() { # what was blocked in the last hour: allow one of them
  local out pick
  local -a items=()
  out="$("$ENGINE" blocked 60 2>/dev/null)" || { info "$(plain "$out")"; return 0; }
  while IFS="$TAB" read -r _ key when name host why; do
    [ -n "$key" ] || continue
    printf '%s\n' "${items[@]}" | grep -qxF "$key" && continue
    items+=("$key" "$(date -d "@$when" '+%H:%M') - $name ($why${host:+, to $host})")
  done < <(grep "^BLOCKED${TAB}" <<< "$out")
  if [ "${#items[@]}" -eq 0 ]; then info "Nothing was blocked in the last hour."; return 0; fi
  pick="$(kdialog --title "$TITLE" --menu "Something stopped working? These were blocked in the last hour.${NL}Pick one to allow it:" "${items[@]}")" || return 0
  out="$("$ENGINE" allow "$pick" 2>/dev/null)"
  say "${out:-That did not work.}"
}

advanced() { # the details: real files, answers and blocked addresses
  local tmp
  tmp="$(mktemp)" || return 0
  {
    echo "Every program that tried to use the internet, as OpenSnitch rules see it (answer, kind, real file or app id):"
    "$ENGINE" list 2>/dev/null | awk -F"$TAB" '$1 == "APP" { printf "%-6s %-8s %s  (%s)%s\n", $3, $4, $5, $2, ($6 != "-" ? "  RED: " $6 : "") }'
    echo
    echo "Blocked in the last day (time, program, address, why):"
    while IFS="$TAB" read -r _ _ when name host why; do
      echo "$(date -d "@$when" '+%m-%d %H:%M')  $name  $host  $why"
    done < <("$ENGINE" blocked 1440 2>/dev/null | grep "^BLOCKED${TAB}")
  } > "$tmp"
  kdialog --title "$TITLE - Advanced view" --textbox "$tmp" 900 600 || true
  rm -f -- "$tmp"
}

main_menu() {
  local status list lock on pick
  local -a items=() mine=() ours=()
  status="$("$ENGINE" status 2>/dev/null)" || { info "$(plain "$status")"; return 1; }
  on="$(awk -F"$TAB" '$1 == "SERVICE" { print $2 }' <<< "$status")"
  lock="$(awk -F"$TAB" '$1 == "LOCKDOWN" { print $2 }' <<< "$status")"
  list="$("$ENGINE" list 2>/dev/null)"
  while IFS="$TAB" read -r _ key answer kind name red; do
    [ -n "$key" ] || continue
    case "$kind" in
      system|steam) ours+=("$name") ;;
      *) mine+=("$key" "$name - $(word "$answer")$([ "$red" != "-" ] && echo " (careful: $red)")") ;;
    esac
  done < <(grep "^APP${TAB}" <<< "$list")
  items=(today "Today: which apps went online" undo "Something stopped working? (blocked in the last hour)")
  if [ "$lock" = on ]; then items+=(lockoff "Lock down is ON - turn it off"); else items+=(lockon "Lock down (block every NEW program, for travel and public Wi-Fi)"); fi
  items+=("${mine[@]}")
  [ "${#ours[@]}" -gt 0 ] && items+=(ours "ForgeOS programs and Steam: always allowed (${#ours[@]})")
  items+=(advanced "Advanced view (the details)")
  if [ "$on" = on ]; then items+=(off "Turn Ask Before Connecting off"); else items+=(on "Ask Before Connecting is OFF - turn it on"); fi
  pick="$(kdialog --title "$TITLE" --menu "The first time a program tries to use the internet, this PC asks you.${NL}Pick an app to change your answer." "${items[@]}")" || return 1
  case "$pick" in
    today) today ;;
    undo) undo ;;
    lockon) say "$("$ENGINE" lockdown on 2>/dev/null)" ;;
    lockoff) say "$("$ENGINE" lockdown off 2>/dev/null)" ;;
    ours) info "These came with ForgeOS (or are Steam and its games) and may always use the internet:${NL}${NL}$(printf '%s\n' "${ours[@]}" | sort -u)" ;;
    advanced) advanced ;;
    on|off) say "$("$ENGINE" "$pick" 2>/dev/null)" ;;
    *) while IFS="$TAB" read -r _ key answer _ name red; do
         [ "$key" = "$pick" ] && { one_app "$key" "$name" "$answer" "$red"; break; }
       done < <(grep "^APP${TAB}" <<< "$list") ;;
  esac
  return 0
}

while main_menu; do :; done
exit 0
