#!/usr/bin/env bash
# ForgeOS AI Setup — the "pick a model" brain (Steps 4 + 6).
# Detects graphics memory, recommends the best free local AI model that fits,
# asks for permission first, and downloads it via Ollama only if the user says Yes.
set -euo pipefail

# --- Model table: keep tags + sizes in ONE place so they're easy to change ---
MODEL_LARGE="qwen3.8:27b"   # 20 GB or more VRAM
SIZE_LARGE="~18 GB"
MODEL_MEDIUM="gpt-oss:20b"  # 12 - 19.9 GB VRAM
SIZE_MEDIUM="~14 GB"
MODEL_SMALL="gemma4:e4b"    # 8 - 11.9 GB VRAM
SIZE_SMALL="~7 GB"
MODEL_MINI="gemma4:e2b"     # under 8 GB, or no GPU found
SIZE_MINI="~5 GB"

# VRAM thresholds in MB (decimal gigabytes: 8 / 12 / 20)
VRAM_LARGE_MB=20000
VRAM_MEDIUM_MB=12000
VRAM_SMALL_MB=8000

# Prints total VRAM in MB.
detect_vram_mb() {
    # 1) Test override (for automated tests).
    if [[ -n "${FORGEOS_FAKE_VRAM_MB:-}" ]]; then
        printf '%s\n' "$FORGEOS_FAKE_VRAM_MB"
        return 0
    fi

    local vram=""

    # 2) NVIDIA: total memory of the largest GPU (MB).
    if command -v nvidia-smi >/dev/null 2>&1; then
        vram=$(nvidia-smi --query-gpu=memory.total --format=csv,noheader,nounits 2>/dev/null \
            | awk 'NF { gsub(/[^0-9]/, "", $1); if ($1 + 0 > max) max = $1 + 0 } END { print max + 0 }') || vram=""
        if [[ "$vram" =~ ^[0-9]+$ ]] && (( vram > 0 )); then
            printf '%s\n' "$vram"
            return 0
        fi
    fi

    # 3) AMD: largest card's mem_info_vram_total (bytes -> MB).
    local best=0 f val
    for f in /sys/class/drm/card*/device/mem_info_vram_total; do
        [[ -r "$f" ]] || continue
        val=$(cat -- "$f" 2>/dev/null) || continue
        [[ "$val" =~ ^[0-9]+$ ]] || continue
        if (( val > best )); then
            best=$val
        fi
    done
    if (( best > 0 )); then
        printf '%s\n' $(( best / 1024 / 1024 ))
        return 0
    fi

    # 4) No GPU found.
    printf '0\n'
}

# Prints the model tag for a given VRAM amount (MB).
choose_model() {
    local vram_mb=$1
    if (( vram_mb >= VRAM_LARGE_MB )); then
        printf '%s\n' "$MODEL_LARGE"
    elif (( vram_mb >= VRAM_MEDIUM_MB )); then
        printf '%s\n' "$MODEL_MEDIUM"
    elif (( vram_mb >= VRAM_SMALL_MB )); then
        printf '%s\n' "$MODEL_SMALL"
    else
        printf '%s\n' "$MODEL_MINI"
    fi
}

# Prints the approximate download size text for a model tag.
model_size() {
    local tag=$1
    case "$tag" in
        "$MODEL_LARGE")  printf '%s\n' "$SIZE_LARGE" ;;
        "$MODEL_MEDIUM") printf '%s\n' "$SIZE_MEDIUM" ;;
        "$MODEL_SMALL")  printf '%s\n' "$SIZE_SMALL" ;;
        "$MODEL_MINI")   printf '%s\n' "$SIZE_MINI" ;;
        *)              printf 'unknown size\n' ;;
    esac
}

# ask_yes_no <question>: returns 0 for Yes, 1 for No.
# Tries kdialog, then zenity, then a plain terminal prompt (in that order).
# GUI dialogs are only used when a display is available, so headless sessions
# fall back to the terminal instead of failing.
ask_yes_no() {
    local question=$1 answer=""
    if [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]] && command -v kdialog >/dev/null 2>&1; then
        kdialog --yesno "$question" --title "ForgeOS AI Setup"
        return $?
    fi
    if [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]] && command -v zenity >/dev/null 2>&1; then
        zenity --question --text="$question" --title="ForgeOS AI Setup"
        return $?
    fi
    printf '%s [y/N] ' "$question"
    IFS= read -r answer || answer=""
    [[ "${answer,,}" == y* ]]
}

# say <kind> <text>: show a message where the user can see it — menu launches
# have no terminal. kind is "info" or "error". GUI first, then plain echo.
say() {
    local kind=$1 text=$2
    if [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]] && command -v kdialog >/dev/null 2>&1; then
        if [[ "$kind" == "error" ]]; then
            kdialog --title "ForgeOS AI Setup" --error "$text" || true
        else
            kdialog --title "ForgeOS AI Setup" --msgbox "$text" || true
        fi
    elif [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]] && command -v zenity >/dev/null 2>&1; then
        if [[ "$kind" == "error" ]]; then
            zenity --error --text="$text" --title="ForgeOS AI Setup" || true
        else
            zenity --info --text="$text" --title="ForgeOS AI Setup" || true
        fi
    else
        echo "$text"
    fi
}

# pull_model <tag>: download the model with Ollama.
# With kdialog available, shows a moving "busy" progress bar (driven over
# D-Bus) and always closes it afterwards; otherwise streams ollama's own
# output to the terminal. Returns non-zero if the pull fails.
pull_model() {
    local model=$1 ref="" ok=0
    if [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]] && command -v kdialog >/dev/null 2>&1; then
        # Value 0 = moving "busy" bar; kdialog prints a D-Bus reference and the
        # dialog stays open until we close it below.
        if ! ref=$(kdialog --title "ForgeOS AI Setup" \
            --progressbar "Downloading ${model} — this can take a while..." 0); then
            ref=""
        fi
    fi

    if [[ -n "$ref" ]]; then
        ollama pull "$model" >/dev/null 2>&1 && ok=1
        dbus-send --session --type=method_call \
            --dest="${ref% *}" "${ref#* }" org.kde.kdialog.ProgressDialog.close || true
    else
        echo "Downloading ${model} — this can take a while..."
        ollama pull "$model" && ok=1
    fi

    if (( ! ok )); then
        say error "Download of ${model} failed."
        return 1
    fi
    return 0
}

# Normal run: check Ollama, ask Yes/No, download only on Yes, save the choice.
run_setup() {
    # 1) Ollama must be answering locally (never over the network).
    if ! curl -sf --max-time 5 http://127.0.0.1:11434/api/version >/dev/null 2>&1; then
        say error "Ollama is not running — nothing was downloaded. Start it first (for example: systemctl start ollama.service) and try again."
        return 1
    fi

    local vram_mb model size question vram_gb=""
    vram_mb=$(detect_vram_mb)
    model=$(choose_model "$vram_mb")
    size=$(model_size "$model")

    # 2) Ask first — the AI may only suggest; nothing happens without a Yes.
    if (( vram_mb > 0 )); then
        vram_gb=$(awk -v mb="$vram_mb" 'BEGIN { printf "%.1f", mb / 1024 }')
        question="Your computer has ${vram_gb} GB graphics memory. Recommended AI: ${model} (${size} download). Download now?"
    else
        question="No dedicated graphics card found. Recommended AI: ${model} (${size} download). Download now?"
    fi
    if ! ask_yes_no "$question"; then
        return 0   # No -> exit quietly, change nothing
    fi

    # 3) Yes -> download (with a progress dialog when possible).
    if ! pull_model "$model"; then
        return 1
    fi

    # 4) Remember the choice for next time.
    local cfg_dir="${HOME:?HOME must be set}/.config/forgeos"
    mkdir -p -- "$cfg_dir"
    printf '%s\n' "$model" > "${cfg_dir}/ai-model"

    # 5) All done.
    say info "Done — open Alpaca to chat with your AI."
}

main() {
    if [[ $# -gt 0 && "${1:-}" != "--dry-run" ]]; then
        echo "usage: forgeos-ai-setup [--dry-run]" >&2
        return 1
    fi
    if [[ $# -gt 1 ]]; then
        echo "usage: forgeos-ai-setup [--dry-run]" >&2
        return 1
    fi

    if [[ "${1:-}" == "--dry-run" ]]; then
        local vram_mb model
        vram_mb=$(detect_vram_mb)
        model=$(choose_model "$vram_mb")
        printf 'VRAM: %s MB\n' "$vram_mb"
        printf 'Model: %s (%s)\n' "$model" "$(model_size "$model")"
        return 0
    fi

    run_setup
}

main "$@"
