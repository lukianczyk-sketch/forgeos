#!/usr/bin/env bash
# ForgeOS Clean Sweep — "I think I've been hacked" button.
# Resets the system back to the genuine, signed ForgeOS image and removes the
# usual places malware hides to restart itself. Personal files are KEPT, but
# anything removed is moved to a quarantine folder (never silently deleted).
#
# Must run as root (the desktop button uses pkexec).
#
# Step 3a: subcommand structure. `scan` runs the core check for now (scanners
# land in Steps 3b/3c); with no arguments the original v1 sweep still runs, so
# the existing GUI keeps working until Step 7 replaces it.
set -euo pipefail

DRY_RUN=0
STAMP="$(date +%Y%m%d-%H%M%S)"
LOG_DIR="/var/log/forgeos/clean-sweep"
QUAR_DIR="/var/lib/forgeos/quarantine"
TAMPER=0
THREATS=0
STARTUP_ITEMS=0

log() { echo "[Clean Sweep] $*" | tee -a "$LOG_FILE"; }

# Core check (Step 3a): verify the booted image is signed, then flag any file
# that was Added or Modified in /etc where malware hides to restart itself.
# `ostree admin config-diff` prints one line per change: a status letter
# (A/M/D), spaces, and the path RELATIVE TO /etc — e.g. "A    ld.so.preload".
core_check() {
  log "Core check: verifying the booted image..."
  local ref=""
  if command -v rpm-ostree >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
    ref="$(rpm-ostree status --json | jq -r '.deployments[] | select(.booted) | ."container-image-reference" // empty')" || true
  elif command -v rpm-ostree >/dev/null 2>&1; then
    # No jq: read the booted entry's origin from the plain-text status.
    ref="$(rpm-ostree status --booted | grep -o 'ostree-[a-z-]*:[^ ]*' | head -n1)" || true
  fi
  case "$ref" in
    ostree-image-signed:*) log "Booted image is signature-verified (signed)." ;;
    *) log "WARNING: booted image does not look signed (reference: ${ref:-unknown})." ;;
  esac

  if ! command -v ostree >/dev/null 2>&1; then
    log "ERROR: ostree not found — cannot check /etc for tampering."
    return 3
  fi

  local diff_out=""
  if ! diff_out="$(ostree admin config-diff)"; then
    log "ERROR: 'ostree admin config-diff' failed — cannot verify /etc."
    return 3
  fi

  local status path
  while read -r status path; do
    case "$status" in
      A|M)
        case "/etc/$path" in
          /etc/systemd/system/*|/etc/cron*|/etc/profile.d/*|/etc/ld.so.preload|\
          /etc/xdg/autostart/*|/etc/rc.local|/etc/rc.d/*|/etc/udev/rules.d/*)
            log "TAMPERED: $status file in a startup spot: /etc/$path"
            TAMPER=1
            ;;
        esac
        ;;
    esac
  done <<< "$diff_out"

  if [ "$TAMPER" -eq 1 ]; then
    log "System files changed — System Reset recommended."
  else
    log "No added/modified files in /etc startup spots."
  fi
  return 0
}

# Virus scan (Step 3b-1): ClamAV over /var, /etc and /tmp (+ /home if it is not a symlink).
# clamscan exit codes: 0 = clean, 1 = virus found, 2 = error — captured with
# `|| rc=$?` so set -e does not abort the script mid-scan. Infected files are
# moved to $QUAR_DIR/$STAMP (unless dry-run), locked chmod 000, and logged in
# quarantine.log as: date <TAB> original path <TAB> sha256 <TAB> threat name.
run_clamscan() {
  # On ForgeOS (Fedora Atomic) /home -> /var/home and /var/tmp is inside /var,
  # so scanning /var covers both; listing them again would scan files twice.
  local -a targets=(/var /etc /tmp)
  if [ -d /home ] && [ ! -L /home ]; then
    targets=(/home "${targets[@]}")
  fi
  log "Virus scan: scanning ${targets[*]}..."

  if ! command -v clamscan >/dev/null 2>&1; then
    log "ERROR: clamscan not found — cannot run the virus scan."
    return 3
  fi

  local rc=0
  local scan_log="$LOG_DIR/clamscan-$STAMP.txt"
  local -a move_args=()
  if [ "$DRY_RUN" -eq 0 ]; then
    if ! mkdir -p "$QUAR_DIR/$STAMP" || ! chmod 700 "$QUAR_DIR/$STAMP"; then
      log "ERROR: could not create quarantine folder $QUAR_DIR/$STAMP."
      return 3
    fi
    move_args=(--move="$QUAR_DIR/$STAMP")
  fi

  clamscan -r -i --no-summary \
    --exclude-dir=^/var/lib/clamav \
    --exclude-dir=^/var/lib/forgeos/quarantine \
    --exclude-dir=^/var/lib/containers/storage \
    "${move_args[@]}" \
    "${targets[@]}" >"$scan_log" 2>&1 || rc=$?

  local line orig threat moved sha256
  local -A found_threat=()

  # Pass 1: count every FOUND line and remember each file's threat name.
  while IFS= read -r line; do
    if [[ "$line" =~ ^(.*)\:\ (.*)\ FOUND[[:space:]]*$ ]]; then
      orig="${BASH_REMATCH[1]}"
      threat="${BASH_REMATCH[2]}"
      found_threat["$orig"]="$threat"
      THREATS=$((THREATS+1))
    fi
  done < "$scan_log"

  # Pass 2: lock each moved file and write its quarantine.log line.
  while IFS= read -r line; do
    if [[ "$line" =~ ^(.*)\:\ moved\ to\ \'(.*)\'[[:space:]]*$ ]]; then
      orig="${BASH_REMATCH[1]}"
      moved="${BASH_REMATCH[2]}"
      sha256="$(sha256sum "$moved" | awk '{print $1}')" || sha256="unknown"
      chmod 000 "$moved" || log "WARNING: could not lock quarantined file: $moved"
      printf '%s\t%s\t%s\t%s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$orig" "${sha256:-unknown}" \
        "${found_threat[$orig]:-unknown}" >>"$QUAR_DIR/quarantine.log"
    fi
  done < "$scan_log"

  if [ "$rc" -eq 2 ]; then
    # clamscan returns 2 for ANY error, even if it also found threats.
    # Threats found still count (exit 1); only a scan that found nothing
    # and errored is a tool error.
    if [ "$THREATS" -eq 0 ]; then
      log "ERROR: virus scan failed (details: $scan_log)"
      return 3
    fi
    log "WARNING: virus scan hit errors on some files (details: $scan_log)"
  fi

  if [ "$THREATS" -gt 0 ]; then
    if [ "$DRY_RUN" -eq 1 ]; then
      log "Virus scan: $THREATS threat(s) found (dry-run — nothing moved)."
    else
      log "Virus scan: $THREATS threat(s) found and locked away."
    fi
  else
    log "Virus scan: no threats found."
  fi
  return 0
}

# Rootkit check (Step 3b-2): rkhunter over system binaries and configs.
# Exit codes: 0 = no warnings, 1 = warnings found — captured with `|| rc=$?`
# so set -e does not abort the script mid-check. Full output is saved to
# $LOG_DIR/rkhunter-$STAMP.txt; each warning line starts with "Warning:".
run_rkhunter() {
  if ! command -v rkhunter >/dev/null 2>&1; then
    log "ERROR: rkhunter not found — cannot run the rootkit check."
    return 3
  fi

  local rc=0
  local scan_log="$LOG_DIR/rkhunter-$STAMP.txt"
  rkhunter --check --sk --rwo --nocolors >"$scan_log" 2>&1 || rc=$?

  # Count the warning lines (each one starts with "Warning:").
  local n=0 line
  while IFS= read -r line; do
    case "$line" in
      Warning:*) n=$((n+1)) ;;
    esac
  done < "$scan_log"

  if [ "$rc" -ne 0 ] && [ "$rc" -ne 1 ]; then
    log "ERROR: rootkit check failed (details: $scan_log)"
    return 3
  fi

  if [ "$n" -gt 0 ]; then
    log "Rootkit check: $n warning(s) — System Reset recommended."
    TAMPER=1
  else
    log "Rootkit check (rkhunter): clean."
  fi
  return 0
}

# Rootkit check (Step 3b-2): chkrootkit over known rootkits. Same pattern as
# rkhunter: output saved to $LOG_DIR/chkrootkit-$STAMP.txt, and a finding is
# any line containing "INFECTED".
run_chkrootkit() {
  if ! command -v chkrootkit >/dev/null 2>&1; then
    log "ERROR: chkrootkit not found — cannot run the rootkit check."
    return 3
  fi

  local rc=0
  local scan_log="$LOG_DIR/chkrootkit-$STAMP.txt"
  chkrootkit -q >"$scan_log" 2>&1 || rc=$?

  # Count the infected findings (any line containing "INFECTED").
  local n=0 line
  while IFS= read -r line; do
    case "$line" in
      *INFECTED*) n=$((n+1)) ;;
    esac
  done < "$scan_log"

  if [ "$rc" -ne 0 ] && [ "$rc" -ne 1 ]; then
    log "ERROR: rootkit check failed (details: $scan_log)"
    return 3
  fi

  if [ "$n" -gt 0 ]; then
    log "Rootkit check: $n infected finding(s) — System Reset recommended."
    TAMPER=1
  else
    log "Rootkit check (chkrootkit): clean."
  fi
  return 0
}

# Startup audit (Step 3c-1): list every place a program could start at boot,
# without changing anything. The list goes to $LOG_DIR/startup-$STAMP.txt with
# a heading before each group; STARTUP_ITEMS counts the entries listed. A
# non-empty /etc/ld.so.preload means code is injected into every process —
# a clean ForgeOS has none, so flag it as tampering (TAMPER=1).
run_startup_audit() {
  local audit_log="$LOG_DIR/startup-$STAMP.txt"
  local preload_set=0
  local f user home uid

  shopt -s nullglob
  STARTUP_ITEMS=0

  # System autostart: every file in /etc/xdg/autostart/.
  echo "System autostart:" > "$audit_log"
  for f in /etc/xdg/autostart/*; do
    [ -f "$f" ] || continue
    echo "$f" >> "$audit_log"
    STARTUP_ITEMS=$((STARTUP_ITEMS+1))
  done

  # System services/timers added by the admin: *.service and *.timer files
  # directly in /etc/systemd/system/ (subdirectories are not listed).
  echo "System services/timers added by the admin:" >> "$audit_log"
  for f in /etc/systemd/system/*.service /etc/systemd/system/*.timer; do
    [ -f "$f" ] || continue
    echo "$f" >> "$audit_log"
    STARTUP_ITEMS=$((STARTUP_ITEMS+1))
  done

  # Cron jobs: /etc/crontab plus every file in /etc/cron.d/ and
  # /var/spool/cron/.
  echo "Cron jobs:" >> "$audit_log"
  if [ -f /etc/crontab ]; then
    echo "/etc/crontab" >> "$audit_log"
    STARTUP_ITEMS=$((STARTUP_ITEMS+1))
  fi
  for f in /etc/cron.d/* /var/spool/cron/*; do
    [ -f "$f" ] || continue
    echo "$f" >> "$audit_log"
    STARTUP_ITEMS=$((STARTUP_ITEMS+1))
  done

  # Preload (ld.so.preload): list its contents if it exists and is not empty.
  echo "Preload (ld.so.preload):" >> "$audit_log"
  if [ -f /etc/ld.so.preload ] && [ -s /etc/ld.so.preload ]; then
    cat -- /etc/ld.so.preload >> "$audit_log"
    STARTUP_ITEMS=$((STARTUP_ITEMS+1))
    preload_set=1
  fi

  # Per-user startup spots, for every real user (UID 1000-59999).
  while IFS=: read -r user _ uid _ _ home _; do
    case "$uid" in ''|*[!0-9]*) continue ;; esac
    if [ "$uid" -ge 1000 ] && [ "$uid" -le 59999 ]; then
      echo "User $user:" >> "$audit_log"
      for f in "$home/.config/autostart/"* "$home/.config/systemd/user/"*; do
        [ -f "$f" ] || continue
        echo "$f" >> "$audit_log"
        STARTUP_ITEMS=$((STARTUP_ITEMS+1))
      done
    fi
  done < <(getent passwd)

  shopt -u nullglob

  if [ "$preload_set" -eq 1 ]; then
    log "Preload file is set — System Reset recommended."
    TAMPER=1
  fi

  log "Startup audit: $STARTUP_ITEMS item(s) listed in $audit_log."
  return 0
}

# Plain-English report (Step 3c-2): one headline up top ("All clear" /
# "N threats found and locked away" / "System files changed — System Reset
# recommended"), then "Scanned: <date>", then each scan log that exists under
# its own "== Title ==" heading. The report is also copied to the pkexec user's
# home — written AS THAT USER (never root) so a symlink in their home cannot
# redirect where we write. Takes the final exit code as $1; always returns 0.
write_report() {
  local rc="$1"
  local report="$LOG_DIR/report-$STAMP.txt"

  # Headline (first line of the report).
  local headline="All clear — no threats found."
  if [ "$rc" -eq 2 ]; then
    headline="System files changed — System Reset recommended."
    if [ "$THREATS" -gt 0 ]; then
      headline="$headline $THREATS threat(s) were also found and locked away."
    fi
  elif [ "$rc" -eq 1 ]; then
    if [ "$DRY_RUN" -eq 1 ]; then
      headline="$THREATS threat(s) found (dry run — nothing was moved)."
    else
      headline="$THREATS threat(s) found and locked away."
    fi
  fi

  {
    echo "$headline"
    echo ""
    echo "Scanned: $(date)"
    echo ""
  } > "$report"

  # Details: each scan log that exists, under its own heading.
  local entry file title
  for entry in \
      "clamscan-$STAMP.txt|Virus scan" \
      "rkhunter-$STAMP.txt|Rootkit check (rkhunter)" \
      "chkrootkit-$STAMP.txt|Rootkit check (chkrootkit)" \
      "startup-$STAMP.txt|Startup programs"; do
    file="$LOG_DIR/${entry%%|*}"
    title="${entry#*|}"
    if [ -f "$file" ]; then
      {
        echo "== $title =="
        if [ -s "$file" ]; then
          cat -- "$file"
        else
          echo "(nothing found)"
        fi
        echo ""
      } >> "$report"
    fi
  done

  # User copy: only when pkexec told us which user asked for the scan.
  # runuser keeps root's environment (HOME=/root under pkexec), so the user's
  # home comes from the passwd entry and is passed in as $1.
  local uid="${PKEXEC_UID:-}" pw="" name="" home=""
  if [ -n "$uid" ]; then
    pw="$(getent passwd "$uid")" || pw=""
    name="$(printf '%s' "$pw" | cut -d: -f1)"
    home="$(printf '%s' "$pw" | cut -d: -f6)"
    if [ -z "$name" ] || [ -z "$home" ]; then
      log "WARNING: PKEXEC_UID=$uid does not match a user — skipping the report copy."
    elif ! runuser -u "$name" -- sh -c 'mkdir -p "$1" && cat > "$1/last-report.txt"' \
        sh "$home/.local/state/forgeos/clean-sweep" < "$report"; then
      log "WARNING: could not save the report copy for user $name — continuing."
    fi
  fi

  log "Report saved: $report"
  return 0
}

# `forgeos-cleansweep scan` (Steps 3a–3c: core check, scanners, startup audit,
# then the plain-English report and final exit code).
run_scan() {
  log "Scan started $(date)."
  if [ "$DRY_RUN" -eq 1 ]; then
    log "Dry-run: scan only — nothing will be moved."
  fi
  core_check || exit 3     # tool error
  run_clamscan || exit 3   # tool error
  run_rkhunter || exit 3   # tool error
  run_chkrootkit || exit 3 # tool error
  run_startup_audit || exit 3 # tool error
  local rc=0
  if [ "$THREATS" -gt 0 ]; then rc=1; fi
  if [ "$TAMPER" -eq 1 ]; then rc=2; fi
  write_report "$rc"
  exit "$rc"
}

# The original v1 sweep, kept working until the new GUI lands (Step 7).
legacy_sweep() {
set +e
  STAMP="$(date +%Y%m%d-%H%M%S)"
  QUAR="/var/lib/forgeos/quarantine/${STAMP}"
  LOG="/var/log/forgeos-cleansweep-${STAMP}.log"

  say()  { echo "[Clean Sweep] $*" | tee -a "$LOG"; }
  quarantine() {  # quarantine <path>  — moves it, keeping its full path inside QUAR
    local p="$1"
    [ -e "$p" ] || [ -L "$p" ] || return 0
    mkdir -p "${QUAR}$(dirname "$p")"
    mv -f -- "$p" "${QUAR}${p}" && say "Quarantined: $p"
  }

  if [ "$(id -u)" -ne 0 ]; then
    echo "Clean Sweep must run as administrator." >&2
    exit 1
  fi

  mkdir -p "$QUAR" /var/log
  chmod 700 /var/lib/forgeos /var/lib/forgeos/quarantine "$QUAR"
  say "Started $(date). Quarantine folder: $QUAR"

  # 1. While still online, stage a fresh, signature-verified copy of ForgeOS
  #    for next boot. Then cut the attacker off by going offline.
  if command -v rpm-ostree >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
    REF="$(rpm-ostree status --json | jq -r '.deployments[] | select(.booted) | ."container-image-reference" // empty')"
    case "$REF" in
      ostree-image-signed:*) ;;
      ostree-unverified-registry:*) REF="ostree-image-signed:docker://${REF#ostree-unverified-registry:}" ;;
      *) REF="" ;;
    esac
    if [ -n "$REF" ]; then
      if rpm-ostree rebase "$REF" >>"$LOG" 2>&1; then
        say "Fresh verified ForgeOS image staged for next restart."
      else
        say "Could not download a fresh image (no internet?). Cleanup continues; run Clean Sweep again later while online."
      fi
    fi
  fi

  if command -v nmcli >/dev/null 2>&1; then
    nmcli networking off && say "Network disconnected."
  fi

  # 2. Remove anything layered on top of the genuine system image.
  if command -v rpm-ostree >/dev/null 2>&1; then
    rpm-ostree cancel >/dev/null 2>&1 || true
    rpm-ostree reset >>"$LOG" 2>&1 && say "Removed added system packages/overrides."
  fi

  # 3. Remove system-wide auto-start hiding spots (anything not shipped with ForgeOS).
  #    On Fedora Atomic the factory copy of /etc lives in /usr/etc.
  SYS_DIRS=(
    /etc/systemd/system /etc/xdg/autostart /etc/profile.d /etc/sudoers.d
    /etc/ssh/sshd_config.d /etc/cron.d /etc/cron.hourly /etc/cron.daily
    /etc/cron.weekly /etc/cron.monthly /etc/yum.repos.d /etc/udev/rules.d
  )
  for d in "${SYS_DIRS[@]}"; do
    [ -d "$d" ] || continue
    while IFS= read -r -d '' f; do
      factory="/usr${f}"
      if [ ! -e "$factory" ] && [ ! -L "$factory" ]; then
        quarantine "$f"                         # added after install
      elif [ -f "$f" ] && ! cmp -s "$f" "$factory"; then
        quarantine "$f"; cp -a "$factory" "$f"  # changed: restore factory copy
      fi
    done < <(find "$d" -mindepth 1 \( -type f -o -type l \) -print0 2>/dev/null)
  done
  for f in /etc/ld.so.preload /etc/rc.local /etc/rc.d/rc.local /etc/crontab; do
    if [ -e "$f" ] && { [ ! -e "/usr$f" ] || ! cmp -s "$f" "/usr$f"; }; then
      quarantine "$f"; [ -e "/usr$f" ] && cp -a "/usr$f" "$f"
    fi
  done
  quarantine /var/spool/cron
  mkdir -p /var/spool/cron && chmod 700 /var/spool/cron

  # 4. Per-user hiding spots + lock out stolen access.
  while IFS=: read -r user _ uid _ _ home _; do
    [ "$uid" -ge 1000 ] && [ "$uid" -lt 60000 ] && [ -d "$home" ] || continue
    for p in "$home/.config/autostart" "$home/.config/systemd/user" \
             "$home/.ssh/authorized_keys" "$home/.config/plasma-workspace/env" \
             "$home/.config/plasma-workspace/shutdown"; do
      quarantine "$p"
    done
    passwd -e "$user" >/dev/null 2>&1 && say "User '$user' must choose a new password at next login."
  done < /etc/passwd
  quarantine /root/.ssh/authorized_keys

  # 5. Reset app permissions to safe defaults and drop leftover runtimes.
  if command -v flatpak >/dev/null 2>&1; then
    flatpak override --reset >>"$LOG" 2>&1 || true
    flatpak uninstall --unused -y --noninteractive >>"$LOG" 2>&1 || true
    say "App permissions reset to defaults."
  fi

  # 6. Scan personal files for known malware, if the scanner is installed.
  if command -v clamscan >/dev/null 2>&1; then
    say "Scanning home folders for malware (this can take a while)..."
    clamscan -r -i --move="${QUAR}/infected" /home >>"$LOG" 2>&1 || true
  fi

  say "Done. Restart the computer to finish. Network stays OFF until you turn it back on."
  say "Removed items are kept in $QUAR. Full log: $LOG"
  exit 0
}

usage() {
  cat >&2 <<'EOF'
Usage: forgeos-cleansweep [scan] [--dry-run]

Commands:
  scan          Check for threats: core check, ClamAV, rkhunter, chkrootkit
  --dry-run     Scan but move nothing
  (no command)  Run the original v1 clean sweep (kept until the new GUI lands, Step 7)

Exit codes: 0 = clean, 1 = threats quarantined, 2 = system tampering found, 3 = tool error.
EOF
}

CMD=""
for arg in "$@"; do
  case "$arg" in
    scan) CMD="scan" ;;
    --dry-run) DRY_RUN=1 ;;
    *) usage; exit 3 ;;
  esac
done
# --dry-run on its own means "scan, move nothing" — never the v1 sweep.
if [ -z "$CMD" ] && [ "$DRY_RUN" -eq 1 ]; then
  CMD="scan"
fi

if [ "$(id -u)" -ne 0 ]; then
  echo "Clean Sweep must run as administrator." >&2
  exit 3
fi

mkdir -p "$LOG_DIR" "$QUAR_DIR"
chmod 700 "$QUAR_DIR"
LOG_FILE="${LOG_DIR}/clean-sweep-${STAMP}.log"

if [ "$CMD" = "scan" ]; then
  run_scan
else
  legacy_sweep
fi
