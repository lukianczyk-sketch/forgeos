#!/usr/bin/env bash
# ForgeOS Clean Sweep — "I think I've been hacked" button.
# Scans for threats (ClamAV, rkhunter, chkrootkit, startup audit) and locks
# them in quarantine (never silently deleted); can put the system back to the
# genuine, signed ForgeOS image keeping personal files (reset-system), or erase
# everything (full-wipe). Run with --help for the commands.
#
# Must run as root (the Clean Sweep window uses pkexec; the weekly timer runs
# as root).
set -euo pipefail

DRY_RUN=0
YES=0
STAMP="$(date +%Y%m%d-%H%M%S)"
LOG_DIR="/var/log/forgeos/clean-sweep"
QUAR_DIR="/var/lib/forgeos/quarantine"
ETC_DIR="/etc"
USR_ETC_DIR="/usr/etc"
RESET_BK_DIR="/var/lib/forgeos/reset-backup"
TMP_DIR="/tmp"
VARTMP_DIR="/var/tmp"
TAMPER=0
THREATS=0
STARTUP_ITEMS=0

log() { echo "[Clean Sweep] $*" | tee -a "$LOG_FILE"; }

# Core check (Step 3a): verify the booted image is signed, then flag any file
# that was Added or Modified in /etc where malware hides to restart itself.
# `ostree admin config-diff` prints one line per change: a status letter
# (A/M/D), spaces, and the path RELATIVE TO /etc — e.g. "A    ld.so.preload".
core_check() {
  log "Core check: verifying the booted image..."
  local ref=""
  if command -v rpm-ostree >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
    ref="$(rpm-ostree status --json | jq -r '.deployments[] | select(.booted) | ."container-image-reference" // empty')" || true
  elif command -v rpm-ostree >/dev/null 2>&1; then
    # No jq: read the booted entry's origin from the plain-text status.
    ref="$(rpm-ostree status --booted | grep -o 'ostree-[a-z-]*:[^ ]*' | head -n1)" || true
  fi
  case "$ref" in
    ostree-image-signed:*) log "Booted image is signature-verified (signed)." ;;
    *) log "WARNING: booted image does not look signed (reference: ${ref:-unknown})." ;;
  esac

  if ! command -v ostree >/dev/null 2>&1; then
    log "ERROR: ostree not found — cannot check /etc for tampering."
    return 3
  fi

  local diff_out=""
  if ! diff_out="$(ostree admin config-diff)"; then
    log "ERROR: 'ostree admin config-diff' failed — cannot verify /etc."
    return 3
  fi

  local status path
  while read -r status path; do
    case "$status" in
      A|M)
        case "/etc/$path" in
          /etc/systemd/system/*|/etc/cron*|/etc/profile.d/*|/etc/ld.so.preload|\
          /etc/xdg/autostart/*|/etc/rc.local|/etc/rc.d/*|/etc/udev/rules.d/*)
            log "TAMPERED: $status file in a startup spot: /etc/$path"
            TAMPER=1
            ;;
        esac
        ;;
    esac
  done <<< "$diff_out"

  if [ "$TAMPER" -eq 1 ]; then
    log "System files changed — System Reset recommended."
  else
    log "No added/modified files in /etc startup spots."
  fi
  return 0
}

# Virus scan (Step 3b-1): ClamAV over /var, /etc and /tmp (+ /home if it is not a symlink).
# clamscan exit codes: 0 = clean, 1 = virus found, 2 = error — captured with
# `|| rc=$?` so set -e does not abort the script mid-scan. Infected files are
# moved to $QUAR_DIR/$STAMP (unless dry-run), locked chmod 000, and logged in
# quarantine.log as 7 tab-separated fields: date <TAB> original path <TAB> sha256
# <TAB> threat name <TAB> moved path <TAB> mode <TAB> owner (uid:gid).
run_clamscan() {
  # On ForgeOS (Fedora Atomic) /home -> /var/home and /var/tmp is inside /var,
  # so scanning /var covers both; listing them again would scan files twice.
  local -a targets=(/var /etc /tmp)
  if [ -d /home ] && [ ! -L /home ]; then
    targets=(/home "${targets[@]}")
  fi
  log "Virus scan: scanning ${targets[*]}..."

  if ! command -v clamscan >/dev/null 2>&1; then
    log "ERROR: clamscan not found — cannot run the virus scan."
    return 3
  fi

  local rc=0
  local scan_log="$LOG_DIR/clamscan-$STAMP.txt"
  local -a move_args=()
  if [ "$DRY_RUN" -eq 0 ]; then
    if ! mkdir -p "$QUAR_DIR/$STAMP" || ! chmod 700 "$QUAR_DIR/$STAMP"; then
      log "ERROR: could not create quarantine folder $QUAR_DIR/$STAMP."
      return 3
    fi
    move_args=(--move="$QUAR_DIR/$STAMP")
  fi

  clamscan -r -i --no-summary \
    --exclude-dir=^/var/lib/clamav \
    --exclude-dir=^/var/lib/forgeos/quarantine \
    --exclude-dir=^/var/lib/containers/storage \
    "${move_args[@]}" \
    "${targets[@]}" >"$scan_log" 2>&1 || rc=$?

  local line orig key threat moved sha256 mode owner
  local -A found_threat=()

  # Pass 1: count every FOUND line and remember each file's threat name.
  while IFS= read -r line; do
    if [[ "$line" =~ ^(.*)\:\ (.*)\ FOUND[[:space:]]*$ ]]; then
      orig="${BASH_REMATCH[1]}"
      threat="${BASH_REMATCH[2]}"
      found_threat["$orig"]="$threat"
      THREATS=$((THREATS+1))
    fi
  done < "$scan_log"

  # Pass 2: lock each moved file and write its quarantine.log line.
  while IFS= read -r line; do
    if [[ "$line" =~ ^(.*)\:\ moved\ to\ \'(.*)\'[[:space:]]*$ ]]; then
      orig="${BASH_REMATCH[1]}"
      moved="${BASH_REMATCH[2]}"
      # Through a symlink, clamscan prints "<path> (real path: '<real>'): moved to ...".
      # The FOUND line used <path>; the file really lived at <real>, so record that.
      key="$orig"
      if [[ "$orig" =~ ^(.*)\ \(real\ path:\ \'(.*)\'\)$ ]]; then
        key="${BASH_REMATCH[1]}"
        orig="${BASH_REMATCH[2]}"
      fi
      sha256="$(sha256sum "$moved" | awk '{print $1}')" || sha256="unknown"
      # Remember the original mode and owner BEFORE chmod 000, so Step 4b can put them back.
      mode="$(stat -c %a "$moved")" || mode="unknown"
      owner="$(stat -c %u:%g "$moved")" || owner="unknown"
      chmod 000 "$moved" || log "WARNING: could not lock quarantined file: $moved"
      printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
        "$(date '+%Y-%m-%d %H:%M:%S')" "$orig" "${sha256:-unknown}" \
        "${found_threat[$key]:-unknown}" "$moved" "${mode:-unknown}" "${owner:-unknown}" >>"$QUAR_DIR/quarantine.log"
    fi
  done < "$scan_log"

  if [ "$rc" -eq 2 ]; then
    # clamscan returns 2 for ANY error, even if it also found threats.
    # Threats found still count (exit 1); only a scan that found nothing
    # and errored is a tool error.
    if [ "$THREATS" -eq 0 ]; then
      log "ERROR: virus scan failed (details: $scan_log)"
      return 3
    fi
    log "WARNING: virus scan hit errors on some files (details: $scan_log)"
  fi

  if [ "$THREATS" -gt 0 ]; then
    if [ "$DRY_RUN" -eq 1 ]; then
      log "Virus scan: $THREATS threat(s) found (dry-run — nothing moved)."
    else
      log "Virus scan: $THREATS threat(s) found and locked away."
    fi
  else
    log "Virus scan: no threats found."
  fi
  return 0
}

# Rootkit check (Step 3b-2): rkhunter over system binaries and configs.
# Exit codes: 0 = no warnings, 1 = warnings found — captured with `|| rc=$?`
# so set -e does not abort the script mid-check. Full output is saved to
# $LOG_DIR/rkhunter-$STAMP.txt; each warning line starts with "Warning:".
run_rkhunter() {
  if ! command -v rkhunter >/dev/null 2>&1; then
    log "ERROR: rkhunter not found — cannot run the rootkit check."
    return 3
  fi

  local rc=0
  local scan_log="$LOG_DIR/rkhunter-$STAMP.txt"
  rkhunter --check --sk --rwo --nocolors >"$scan_log" 2>&1 || rc=$?

  # Count the warning lines (each one starts with "Warning:").
  local n=0 line
  while IFS= read -r line; do
    case "$line" in
      Warning:*) n=$((n+1)) ;;
    esac
  done < "$scan_log"

  if [ "$rc" -ne 0 ] && [ "$rc" -ne 1 ]; then
    log "ERROR: rootkit check failed (details: $scan_log)"
    return 3
  fi

  if [ "$n" -gt 0 ]; then
    log "Rootkit check: $n warning(s) — System Reset recommended."
    TAMPER=1
  else
    log "Rootkit check (rkhunter): clean."
  fi
  return 0
}

# Rootkit check (Step 3b-2): chkrootkit over known rootkits. Same pattern as
# rkhunter: output saved to $LOG_DIR/chkrootkit-$STAMP.txt, and a finding is
# any line containing "INFECTED".
run_chkrootkit() {
  if ! command -v chkrootkit >/dev/null 2>&1; then
    log "ERROR: chkrootkit not found — cannot run the rootkit check."
    return 3
  fi

  local rc=0
  local scan_log="$LOG_DIR/chkrootkit-$STAMP.txt"
  chkrootkit -q >"$scan_log" 2>&1 || rc=$?

  # Count the infected findings (any line containing "INFECTED").
  local n=0 line
  while IFS= read -r line; do
    case "$line" in
      *INFECTED*) n=$((n+1)) ;;
    esac
  done < "$scan_log"

  if [ "$rc" -ne 0 ] && [ "$rc" -ne 1 ]; then
    log "ERROR: rootkit check failed (details: $scan_log)"
    return 3
  fi

  if [ "$n" -gt 0 ]; then
    log "Rootkit check: $n infected finding(s) — System Reset recommended."
    TAMPER=1
  else
    log "Rootkit check (chkrootkit): clean."
  fi
  return 0
}

# Startup audit (Step 3c-1): list every place a program could start at boot,
# without changing anything. The list goes to $LOG_DIR/startup-$STAMP.txt with
# a heading before each group; STARTUP_ITEMS counts the entries listed. A
# non-empty /etc/ld.so.preload means code is injected into every process —
# a clean ForgeOS has none, so flag it as tampering (TAMPER=1).
run_startup_audit() {
  local audit_log="$LOG_DIR/startup-$STAMP.txt"
  local preload_set=0
  local f user home uid

  shopt -s nullglob
  STARTUP_ITEMS=0

  # System autostart: every file in /etc/xdg/autostart/.
  echo "System autostart:" > "$audit_log"
  for f in /etc/xdg/autostart/*; do
    [ -f "$f" ] || continue
    echo "$f" >> "$audit_log"
    STARTUP_ITEMS=$((STARTUP_ITEMS+1))
  done

  # System services/timers added by the admin: *.service and *.timer files
  # directly in /etc/systemd/system/ (subdirectories are not listed).
  echo "System services/timers added by the admin:" >> "$audit_log"
  for f in /etc/systemd/system/*.service /etc/systemd/system/*.timer; do
    [ -f "$f" ] || continue
    echo "$f" >> "$audit_log"
    STARTUP_ITEMS=$((STARTUP_ITEMS+1))
  done

  # Cron jobs: /etc/crontab plus every file in /etc/cron.d/ and
  # /var/spool/cron/.
  echo "Cron jobs:" >> "$audit_log"
  if [ -f /etc/crontab ]; then
    echo "/etc/crontab" >> "$audit_log"
    STARTUP_ITEMS=$((STARTUP_ITEMS+1))
  fi
  for f in /etc/cron.d/* /var/spool/cron/*; do
    [ -f "$f" ] || continue
    echo "$f" >> "$audit_log"
    STARTUP_ITEMS=$((STARTUP_ITEMS+1))
  done

  # Preload (ld.so.preload): list its contents if it exists and is not empty.
  echo "Preload (ld.so.preload):" >> "$audit_log"
  if [ -f /etc/ld.so.preload ] && [ -s /etc/ld.so.preload ]; then
    cat -- /etc/ld.so.preload >> "$audit_log"
    STARTUP_ITEMS=$((STARTUP_ITEMS+1))
    preload_set=1
  fi

  # Per-user startup spots, for every real user (UID 1000-59999).
  while IFS=: read -r user _ uid _ _ home _; do
    case "$uid" in ''|*[!0-9]*) continue ;; esac
    if [ "$uid" -ge 1000 ] && [ "$uid" -le 59999 ]; then
      echo "User $user:" >> "$audit_log"
      for f in "$home/.config/autostart/"* "$home/.config/systemd/user/"*; do
        [ -f "$f" ] || continue
        echo "$f" >> "$audit_log"
        STARTUP_ITEMS=$((STARTUP_ITEMS+1))
      done
    fi
  done < <(getent passwd)

  shopt -u nullglob

  if [ "$preload_set" -eq 1 ]; then
    log "Preload file is set — System Reset recommended."
    TAMPER=1
  fi

  log "Startup audit: $STARTUP_ITEMS item(s) listed in $audit_log."
  return 0
}

# Plain-English report (Step 3c-2): one headline up top ("All clear" /
# "N threats found and locked away" / "System files changed — System Reset
# recommended"), then "Scanned: <date>", then each scan log that exists under
# its own "== Title ==" heading. The report is also copied to the pkexec user's
# home — written AS THAT USER (never root) so a symlink in their home cannot
# redirect where we write. Takes the final exit code as $1; always returns 0.
write_report() {
  local rc="$1"
  local report="$LOG_DIR/report-$STAMP.txt"

  # Headline (first line of the report).
  local headline="All clear — no threats found."
  if [ "$rc" -eq 2 ]; then
    headline="System files changed — System Reset recommended."
    if [ "$THREATS" -gt 0 ]; then
      headline="$headline $THREATS threat(s) were also found and locked away."
    fi
  elif [ "$rc" -eq 1 ]; then
    if [ "$DRY_RUN" -eq 1 ]; then
      headline="$THREATS threat(s) found (dry run — nothing was moved)."
    else
      headline="$THREATS threat(s) found and locked away."
    fi
  fi

  {
    echo "$headline"
    echo ""
    echo "Scanned: $(date)"
    echo ""
  } > "$report"

  # Details: each scan log that exists, under its own heading.
  local entry file title
  for entry in \
      "clamscan-$STAMP.txt|Virus scan" \
      "rkhunter-$STAMP.txt|Rootkit check (rkhunter)" \
      "chkrootkit-$STAMP.txt|Rootkit check (chkrootkit)" \
      "startup-$STAMP.txt|Startup programs"; do
    file="$LOG_DIR/${entry%%|*}"
    title="${entry#*|}"
    if [ -f "$file" ]; then
      {
        echo "== $title =="
        if [ -s "$file" ]; then
          cat -- "$file"
        else
          echo "(nothing found)"
        fi
        echo ""
      } >> "$report"
    fi
  done

  # User copy: only when pkexec told us which user asked for the scan.
  # runuser keeps root's environment (HOME=/root under pkexec), so the user's
  # home comes from the passwd entry and is passed in as $1.
  local uid="${PKEXEC_UID:-}" pw="" name="" home=""
  if [ -n "$uid" ]; then
    pw="$(getent passwd "$uid")" || pw=""
    name="$(printf '%s' "$pw" | cut -d: -f1)"
    home="$(printf '%s' "$pw" | cut -d: -f6)"
    if [ -z "$name" ] || [ -z "$home" ]; then
      log "WARNING: PKEXEC_UID=$uid does not match a user — skipping the report copy."
    elif ! runuser -u "$name" -- sh -c 'mkdir -p "$1" && cat > "$1/last-report.txt"' \
        sh "$home/.local/state/forgeos/clean-sweep" < "$report"; then
      log "WARNING: could not save the report copy for user $name — continuing."
    fi
  fi

  log "Report saved: $report"
  return 0
}

# `forgeos-cleansweep quarantine list` (Step 4a): show what is locked away.
# Reads the 7-field quarantine.log lines written by run_clamscan; skips old
# 4-field lines and entries whose file has already been removed from the
# quarantine folder. ID = the moved path without the $QUAR_DIR/ prefix.
quarantine_list() {
  local qdate qorig qthreat qmoved id printed=0
  local prefix="$QUAR_DIR/"
  if [ ! -f "$QUAR_DIR/quarantine.log" ]; then
    echo "Quarantine is empty."
    return 0
  fi
  # Fields: date, original path, sha256, threat, moved path, mode, owner
  # (sha256 / mode / owner are only needed by restore, Step 4b).
  while IFS=$'\t' read -r qdate qorig _ qthreat qmoved _ _; do
    [ -n "$qmoved" ] || continue   # old 4-field line — no moved path recorded
    [ -e "$qmoved" ] || continue   # file is no longer in the quarantine folder
    id="${qmoved#"$prefix"}"
    if [ "$printed" -eq 0 ]; then
      printf 'ID\tDate\tThreat\tOriginal location\n'
      printed=1
    fi
    printf '%s\t%s\t%s\t%s\n' "$id" "$qdate" "$qthreat" "$qorig"
  done < "$QUAR_DIR/quarantine.log"
  if [ "$printed" -eq 0 ]; then
    echo "Quarantine is empty."
  fi
  return 0
}

# Ask a yes/no question on the terminal (Step 4b-1). --yes skips it; with no
# terminal there is nobody to ask, so refuse instead of guessing.
confirm() {
  local q="$1" ans=""
  if [ "$YES" -eq 1 ]; then
    return 0
  fi
  if [ ! -t 0 ]; then
    echo "No terminal to ask on — add --yes to confirm." >&2
    exit 3
  fi
  read -r -p "$q [y/N] " ans
  case "$ans" in
    y|Y) return 0 ;;
    *)   return 1 ;;
  esac
}

# Find a quarantined file by ID (Step 4b-1). Refuses IDs that could escape
# the quarantine folder; on success fills F_DATE/F_ORIG/F_SHA/F_THREAT/
# F_MOVED/F_MODE/F_OWNER from the LAST matching quarantine.log line.
quarantine_find() {
  local id="$1" want found=0 qdate qorig qsha qthreat qmoved qmode qowner
  if [ -z "$id" ]; then
    echo "Bad ID: $id" >&2
    exit 3
  fi
  case "$id" in
    /*|*..*)
      echo "Bad ID: $id" >&2
      exit 3
      ;;
  esac
  want="$QUAR_DIR/$id"
  if [ ! -f "$QUAR_DIR/quarantine.log" ]; then
    echo "No quarantined file with ID $id." >&2
    exit 3
  fi
  while IFS=$'\t' read -r qdate qorig qsha qthreat qmoved qmode qowner; do
    if [ "$qmoved" = "$want" ]; then
      F_DATE="$qdate"; F_ORIG="$qorig"; F_SHA="$qsha"
      F_THREAT="$qthreat"; F_MOVED="$qmoved"; F_MODE="$qmode"; F_OWNER="$qowner"
      found=1
    fi
  done < "$QUAR_DIR/quarantine.log"
  if [ "$found" -eq 0 ] || [ ! -e "$F_MOVED" ]; then
    echo "No quarantined file with ID $id." >&2
    exit 3
  fi
}

# `forgeos-cleansweep quarantine restore <id>` (Step 4b-1): put one locked-away
# file back where it came from — only if it is byte-for-byte what was
# quarantined and the original spot is still empty.
quarantine_restore() {
  local now dir uid name mode
  quarantine_find "$QID"
  now="$(sha256sum "$F_MOVED" | awk '{print $1}')" || now=""
  if [ "$F_SHA" = "unknown" ] || [ "$now" != "$F_SHA" ]; then
    echo "Refusing: the quarantined file has changed since it was locked away." >&2
    exit 3
  fi
  if [ -e "$F_ORIG" ] || [ -L "$F_ORIG" ]; then
    echo "Refusing: something already exists at $F_ORIG (will not overwrite)." >&2
    exit 3
  fi
  dir="$(dirname "$F_ORIG")"
  if [ ! -d "$dir" ]; then
    echo "Refusing: folder $dir no longer exists." >&2
    exit 3
  fi
  mode="$F_MODE"
  [ "$mode" != "unknown" ] || mode=600
  uid="${F_OWNER%%:*}"
  echo "WARNING: this file was flagged as: $F_THREAT (locked away $F_DATE)."
  echo "Only restore it if you are sure it is safe."
  if ! confirm "Restore it to $F_ORIG?"; then
    echo "Cancelled — nothing was changed."
    exit 0
  fi
  if [ "$F_OWNER" != "unknown" ] && [ "$uid" != 0 ]; then
    # A user's file is written back AS that user (no-overwrite), so a swapped
    # folder or symlink can only send it where that user could write anyway.
    name="$(getent passwd "$uid" | cut -d: -f1)" || name=""
    if [ -z "$name" ]; then
      echo "Refusing: the file's owner (uid $uid) no longer exists." >&2
      exit 3
    fi
    # shellcheck disable=SC2016  # $1..$3 expand inside the user's sh, not here
    if ! runuser -u "$name" -- sh -c 'set -C; umask 077; cat > "$1" && chmod "$2" "$1" && { chgrp "$3" "$1" 2>/dev/null || true; }' \
        sh "$F_ORIG" "$mode" "${F_OWNER#*:}" < "$F_MOVED"; then
      echo "ERROR: could not restore the file." >&2
      exit 3
    fi
    rm -f -- "$F_MOVED"
  else
    # A root-owned file only goes back into a real (no symlinks) root-owned
    # folder. Mode/owner are set while it is still in the root-only quarantine.
    if [ "$(realpath -e -- "$dir" 2>/dev/null)" != "$dir" ] || [ "$(stat -c %u -- "$dir")" != 0 ]; then
      echo "Refusing: $dir is not a root-owned folder — will not put a root file there." >&2
      exit 3
    fi
    chmod "$mode" "$F_MOVED" || { echo "ERROR: could not set the file's mode." >&2; exit 3; }
    if [ "$F_OWNER" != "unknown" ]; then
      chown "$F_OWNER" "$F_MOVED" || { echo "ERROR: could not set the file's owner." >&2; exit 3; }
    fi
    mv -n -- "$F_MOVED" "$F_ORIG" || true
    if [ -e "$F_MOVED" ]; then
      chmod 000 "$F_MOVED" || true
      echo "ERROR: could not restore the file." >&2
      exit 3
    fi
  fi
  tidy_quar_dir "$F_MOVED"
  log "Restored $F_ORIG from quarantine (ID $QID)."
  echo "Restored: $F_ORIG"
  exit 0
}

# Remove a scan's quarantine sub-folder once its last file is gone
# (rmdir only removes empty folders; never touches $QUAR_DIR itself).
tidy_quar_dir() {
  local d
  d="$(dirname -- "$1")"
  [ "$d" != "$QUAR_DIR" ] || return 0
  rmdir -- "$d" 2>/dev/null || true
}

# `forgeos-cleansweep quarantine delete <id|all>` (Step 4b-2): permanently
# remove a quarantined file — asks first, and with --yes or no terminal it
# behaves like the other confirm() calls.
quarantine_delete() {
  local -a files=()
  local f qmoved dup
  if [ "$QID" = "all" ]; then
    # Collect every quarantined file that still exists (skip duplicates).
    if [ -f "$QUAR_DIR/quarantine.log" ]; then
      while IFS=$'\t' read -r _ _ _ _ qmoved _ _; do
        [ -n "$qmoved" ] || continue   # old 4-field line — no moved path recorded
        [ -e "$qmoved" ] || continue   # file is no longer in the quarantine folder
        dup=0
        for f in "${files[@]}"; do
          if [ "$f" = "$qmoved" ]; then dup=1; fi
        done
        if [ "$dup" -eq 0 ]; then files+=("$qmoved"); fi
      done < "$QUAR_DIR/quarantine.log"
    fi
    if [ "${#files[@]}" -eq 0 ]; then
      echo "Quarantine is empty."
      exit 0
    fi
    if ! confirm "Delete all ${#files[@]} quarantined file(s) for good?"; then
      echo "Cancelled — nothing was changed."
      exit 0
    fi
    for f in "${files[@]}"; do
      rm -f -- "$f" || { echo "ERROR: could not delete $f" >&2; exit 3; }
      tidy_quar_dir "$f"
    done
    log "Deleted all quarantined files (${#files[@]})."
    echo "Deleted ${#files[@]} quarantined file(s)."
    exit 0
  fi

  quarantine_find "$QID"
  echo "This will permanently delete: $F_ORIG (flagged as: $F_THREAT)"
  if ! confirm "Delete it for good?"; then
    echo "Cancelled — nothing was changed."
    exit 0
  fi
  rm -f -- "$F_MOVED" || { echo "ERROR: could not delete the file." >&2; exit 3; }
  tidy_quar_dir "$F_MOVED"
  log "Deleted quarantined file $F_ORIG (ID $QID)."
  echo "Deleted: $F_ORIG"
  exit 0
}

# `forgeos-cleansweep quarantine ...`: dispatch the sub-command.
# list, restore and delete all work now (Steps 4a–4b).
quarantine_cmd() {
  case "$QSUB" in
    list)
      quarantine_list
      exit 0
      ;;
    restore)
      quarantine_restore
      ;;
    delete)
      quarantine_delete
      ;;
  esac
}

# `forgeos-cleansweep scan` (Steps 3a–3c: core check, scanners, startup audit,
# then the plain-English report and final exit code).
run_scan() {
  log "Scan started $(date)."
  if [ "$DRY_RUN" -eq 1 ]; then
    log "Dry-run: scan only — nothing will be moved."
  fi
  local rc=0
  scan_steps || rc=$?
  exit "$rc"
}

# The actual scan steps (Steps 3a–3c): core check, scanners, startup audit,
# then the plain-English report. Returns 0 = clean, 1 = threats quarantined,
# 2 = system tampering found, 3 = tool error — so a reset can run it and keep
# going (Step 5d).
scan_steps() {
  core_check || return 3     # tool error
  run_clamscan || return 3   # tool error
  run_rkhunter || return 3   # tool error
  run_chkrootkit || return 3 # tool error
  run_startup_audit || return 3 # tool error
  local rc=0
  if [ "$THREATS" -gt 0 ]; then rc=1; fi
  if [ "$TAMPER" -eq 1 ]; then rc=2; fi
  write_report "$rc"
  return "$rc"
}

# `forgeos-cleansweep reset-system` (Step 5a-1): dry-run plan for /etc only —
# show what a system reset would do to each changed file under /etc. The real
# run comes in Step 5b; personal files are always kept.

# Keep-list: names under /etc that must survive a reset (identity, passwords,
# network and keyboard settings). Takes a path RELATIVE to /etc; returns 0 if
# it is on the list, 1 otherwise. The parent folders are listed too, because
# config-diff can report a whole added folder as ONE line — removing it would
# take the Wi-Fi passwords / keyboard layout with it. resolv.conf keeps DNS.
reset_keep() {
  case "$1" in
    machine-id|passwd|group|shadow|gshadow|subuid|subgid|passwd-|group-|shadow-|gshadow-|.pwd.lock|.updated|hostname|fstab|crypttab|locale.conf|vconsole.conf|localtime|adjtime|X11/xorg.conf.d/00-keyboard.conf|NetworkManager/system-connections/*|\
    resolv.conf|NetworkManager|NetworkManager/system-connections|X11|X11/xorg.conf.d)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

# Plan the /etc restore: one line per file from `ostree admin config-diff` —
# M (modified) -> factory copy back, A (added) -> moved to backup,
# D (deleted) -> factory copy put back. Keep-list files are skipped.
# Step 5b: called with "apply" it does the work for real; default is plan.
reset_etc_plan() {
  local mode="${1:-plan}"

  if ! command -v ostree >/dev/null 2>&1; then
    log "ERROR: ostree not found."
    return 3
  fi

  local diff_out=""
  if ! diff_out="$(ostree admin config-diff)"; then
    log "ERROR: 'ostree admin config-diff' failed — cannot plan the /etc restore."
    return 3
  fi

  log "3. Restore /etc to factory (keep-list skipped):"

  local status path
  while read -r status path; do
    [ -n "$path" ] || continue   # empty line in the diff output
    case "$path" in /*|*..*) log "  SKIP     odd path: $path"; continue ;; esac
    if reset_keep "$path"; then
      log "  KEEP     /etc/$path"
      RESET_KEEP=$((RESET_KEEP + 1))
    else
      case "$status" in
        M)
          log "  RESTORE  /etc/$path (factory copy from /usr/etc; old one backed up)"
          RESET_RESTORE=$((RESET_RESTORE + 1))
          if [ "$mode" = "apply" ]; then
            if ! mkdir -p "$(dirname "$RESET_BK/etc/$path")"; then log "  ERROR: could not make the backup folder for /etc/$path."; RESET_ERRORS=$((RESET_ERRORS + 1)); continue; fi
            if ! mv -- "$ETC_DIR/$path" "$RESET_BK/etc/$path"; then log "  ERROR: could not back up /etc/$path."; RESET_ERRORS=$((RESET_ERRORS + 1)); continue; fi
            if ! cp -a -- "$USR_ETC_DIR/$path" "$ETC_DIR/$path"; then
              log "  ERROR: could not restore /etc/$path from /usr/etc — old copy put back."
              mv -- "$RESET_BK/etc/$path" "$ETC_DIR/$path" || log "  ERROR: could not put the old copy back; it is in $RESET_BK/etc/$path"
              RESET_ERRORS=$((RESET_ERRORS + 1)); continue
            fi
          fi
          ;;
        A)
          log "  REMOVE   /etc/$path (moved to the backup folder)"
          RESET_REMOVE=$((RESET_REMOVE + 1))
          if [ "$mode" = "apply" ]; then
            # Already gone with an added parent folder that was moved first.
            [ -e "$ETC_DIR/$path" ] || [ -L "$ETC_DIR/$path" ] || continue
            if ! mkdir -p "$(dirname "$RESET_BK/etc/$path")"; then log "  ERROR: could not make the backup folder for /etc/$path."; RESET_ERRORS=$((RESET_ERRORS + 1)); continue; fi
            if ! mv -- "$ETC_DIR/$path" "$RESET_BK/etc/$path"; then log "  ERROR: could not move /etc/$path to the backup folder."; RESET_ERRORS=$((RESET_ERRORS + 1)); continue; fi
          fi
          ;;
        D)
          log "  PUT BACK /etc/$path (copied from /usr/etc)"
          RESET_PUTBACK=$((RESET_PUTBACK + 1))
          if [ "$mode" = "apply" ]; then
            if ! mkdir -p "$(dirname "$ETC_DIR/$path")"; then log "  ERROR: could not make the folder for /etc/$path."; RESET_ERRORS=$((RESET_ERRORS + 1)); continue; fi
            if ! cp -a -- "$USR_ETC_DIR/$path" "$ETC_DIR/$path"; then log "  ERROR: could not put back /etc/$path from /usr/etc."; RESET_ERRORS=$((RESET_ERRORS + 1)); continue; fi
          fi
          ;;
      esac
    fi
  done <<< "$diff_out"

  log "  Then: systemctl preset-all (turns factory services back on)."
  if [ "$mode" = "apply" ]; then
    if ! systemctl preset-all; then
      log "  WARNING: systemctl preset-all failed."
      RESET_ERRORS=$((RESET_ERRORS + 1))
    fi
  fi
  return 0
}

# Keep-list warnings: kept files can hide an attacker — flag extra UID 0
# accounts and a changed root password so the user checks them.
reset_keep_warnings() {
  local name etc_root usr_root
  while IFS= read -r name; do
    [ -n "$name" ] || continue
    log "WARNING: extra administrator (UID 0) account found: $name — it is kept, check it!"
    RESET_FLAGS=$((RESET_FLAGS + 1))
  done < <(awk -F: '$3 == 0 && $1 != "root" {print $1}' /etc/passwd)

  if [ -r /usr/etc/shadow ]; then
    etc_root="$(awk -F: '$1 == "root" {print $2}' /etc/shadow)" || etc_root=""
    usr_root="$(awk -F: '$1 == "root" {print $2}' /usr/etc/shadow)" || usr_root=""
    if [ "$etc_root" != "$usr_root" ]; then
      log "NOTE: the root password was changed after install (kept as is)."
      RESET_FLAGS=$((RESET_FLAGS + 1))
    fi
  fi

  if [ "$RESET_FLAGS" -eq 0 ]; then
    log "Keep-list check: no extra admin accounts found."
  fi
  return 0
}

# Signed image reference for the rebase step (Step 5a-2): read the booted
# deployment's container-image-reference and force the ostree-image-signed
# form. Result goes to RESET_REF; never fails.
reset_image_ref() {
  local ref=""
  if command -v rpm-ostree >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
    ref="$(rpm-ostree status --json | jq -r '.deployments[] | select(.booted) | ."container-image-reference" // empty')" || ref=""
  fi
  local booted="$ref"
  case "$ref" in
    ostree-image-signed:*) ;;
    ostree-unverified-registry:*) ref="ostree-image-signed:docker://${ref#ostree-unverified-registry:}" ;;
    *) ref="" ;;
  esac
  RESET_REF="$ref"
  RESET_SAME_REF=0   # already on the signed image -> upgrade instead of rebase (same ref)
  if [ -n "$ref" ] && [ "$booted" = "$ref" ]; then RESET_SAME_REF=1; fi
  return 0
}

# Password reminder (Step 8e): used instead of `passwd -e`, because the KDE login
# screen cannot change an expired password (it freezes and locks the user out).
# Puts a one-time reminder in the user's autostart, written AS the user so a
# symlink in their home cannot redirect it; forgeos-* entries survive a reset.
# Args: user name, home folder. Returns non-zero on failure.
add_password_reminder() {
  # shellcheck disable=SC2016  # $1 expands inside the user's sh, not here
  runuser -u "$1" -- sh -c 'mkdir -p "$1" && printf "%s\n" "[Desktop Entry]" "Type=Application" "Name=Clean Sweep password reminder" "Exec=/usr/libexec/forgeos-password-reminder" "Icon=security-high" "NoDisplay=true" > "$1/forgeos-password-reminder.desktop"' \
    sh "$2/.config/autostart"
}

# Per-user startup spots (Step 5a-2): list what a reset would move or replace
# for each regular user (UID 1000–59999 with an existing home). Personal files
# are untouched; forgeos-* entries are ours and stay. Counts RESET_USERFILES.
# Step 5c: called with "apply" it does the work for real; default is plan.
# In apply mode a failed item is logged + counted, and the loop goes on.
reset_users_plan() {
  local mode="${1:-plan}"
  local user uid home f name
  while IFS=: read -r user _ uid _ _ home _; do
    case "$uid" in
      ''|*[!0-9]*) continue ;;   # not a numeric UID — skip (e.g. empty line)
    esac
    if [ "$uid" -lt 1000 ] || [ "$uid" -ge 60000 ]; then continue; fi
    [ -d "$home" ] || continue

    for f in "$home/.config/autostart/"* \
             "$home/.config/systemd/user/"* \
             "$home/.config/plasma-workspace/env/"* \
             "$home/.config/plasma-workspace/shutdown/"* \
             "$home/.ssh/authorized_keys"; do
      [ -e "$f" ] || [ -L "$f" ] || continue   # empty glob or missing file
      case "$(basename -- "$f")" in
        forgeos-*) continue ;;   # our own entries stay
      esac
      log "  MOVE     $f (to the backup folder)"
      RESET_USERFILES=$((RESET_USERFILES + 1))
      if [ "$mode" = "apply" ]; then
        if ! mkdir -p "$(dirname "$RESET_BK$f")"; then log "  ERROR: could not make the backup folder for $f."; RESET_ERRORS=$((RESET_ERRORS + 1)); continue; fi
        if ! mv -- "$f" "$RESET_BK$f"; then log "  ERROR: could not move $f to the backup folder."; RESET_ERRORS=$((RESET_ERRORS + 1)); continue; fi
      fi
    done

    for name in .bashrc .bash_profile .profile; do
      if [ -e "$home/$name" ] && [ -e "/etc/skel/$name" ] && ! cmp -s "$home/$name" "/etc/skel/$name"; then
        log "  RESET    $home/$name (fresh copy from /etc/skel; old one backed up)"
        RESET_USERFILES=$((RESET_USERFILES + 1))
        if [ "$mode" = "apply" ]; then
          if ! mkdir -p "$(dirname "$RESET_BK$home/$name")"; then log "  ERROR: could not make the backup folder for $home/$name."; RESET_ERRORS=$((RESET_ERRORS + 1)); continue; fi
          if ! mv -- "$home/$name" "$RESET_BK$home/$name"; then log "  ERROR: could not back up $home/$name."; RESET_ERRORS=$((RESET_ERRORS + 1)); continue; fi
          if ! runuser -u "$user" -- cp -- "/etc/skel/$name" "$home/$name"; then
            log "  ERROR: could not copy /etc/skel/$name to $home/$name — old one put back."
            mv -- "$RESET_BK$home/$name" "$home/$name" || log "  ERROR: could not put the old $home/$name back; it is in $RESET_BK$home/$name"
            RESET_ERRORS=$((RESET_ERRORS + 1)); continue
          fi
        fi
      fi
    done

    log "  REMIND   user $user will be asked to choose a new password after the restart"
    if [ "$mode" = "apply" ]; then
      if ! add_password_reminder "$user" "$home"; then log "  ERROR: could not add the password reminder for $user."; RESET_ERRORS=$((RESET_ERRORS + 1)); continue; fi
    fi
  done < <(getent passwd)

  if [ -e /root/.ssh/authorized_keys ]; then
    log "  MOVE     /root/.ssh/authorized_keys (to the backup folder)"
    RESET_USERFILES=$((RESET_USERFILES + 1))
    if [ "$mode" = "apply" ]; then
      if ! mkdir -p "$(dirname "$RESET_BK/root/.ssh/authorized_keys")"; then
        log "  ERROR: could not make the backup folder for /root/.ssh/authorized_keys."
        RESET_ERRORS=$((RESET_ERRORS + 1))
      elif ! mv -- "/root/.ssh/authorized_keys" "$RESET_BK/root/.ssh/authorized_keys"; then
        log "  ERROR: could not move /root/.ssh/authorized_keys to the backup folder."
        RESET_ERRORS=$((RESET_ERRORS + 1))
      fi
    fi
  fi
  return 0
}

# Hiding spots (Step 5a-2): /etc/ld.so.preload, user crontabs in
# /var/spool/cron and the tmp folders. Step 5c: called with "apply" it clears
# them for real — everything is backed up first; default is plan.
reset_clears() {
  local mode="${1:-plan}"
  local f

  if [ -s /etc/ld.so.preload ]; then   # only if not already empty
    log "  CLEAR    /etc/ld.so.preload"
    if [ "$mode" = "apply" ]; then
      if ! mkdir -p "$RESET_BK/etc"; then
        log "  ERROR: could not make the backup folder for /etc/ld.so.preload."
        RESET_ERRORS=$((RESET_ERRORS + 1))
      elif ! cp -a --backup=numbered -- /etc/ld.so.preload "$RESET_BK/etc/ld.so.preload"; then
        log "  ERROR: could not back up /etc/ld.so.preload."
        RESET_ERRORS=$((RESET_ERRORS + 1))
      else
        : > /etc/ld.so.preload || { log "  ERROR: could not empty /etc/ld.so.preload (backup is in $RESET_BK/etc/)."; RESET_ERRORS=$((RESET_ERRORS + 1)); }
      fi
    fi
  fi

  for f in /var/spool/cron/*; do
    [ -e "$f" ] || [ -L "$f" ] || continue   # empty glob or missing file
    log "  MOVE     $f (to the backup folder)"
    if [ "$mode" = "apply" ]; then
      if ! mkdir -p "$RESET_BK/var/spool/cron"; then log "  ERROR: could not make the backup folder for $f."; RESET_ERRORS=$((RESET_ERRORS + 1)); continue; fi
      if ! mv -- "$f" "$RESET_BK/var/spool/cron/"; then log "  ERROR: could not move $f to the backup folder."; RESET_ERRORS=$((RESET_ERRORS + 1)); continue; fi
    fi
  done
  if [ "$mode" = "apply" ]; then
    if ! mkdir -p /var/spool/cron; then
      log "  ERROR: could not make /var/spool/cron."
      RESET_ERRORS=$((RESET_ERRORS + 1))
    elif ! chmod 700 /var/spool/cron; then
      log "  ERROR: could not set the mode on /var/spool/cron."
      RESET_ERRORS=$((RESET_ERRORS + 1))
    fi
  fi

  log "  EMPTY    $TMP_DIR"
  if [ "$mode" = "apply" ]; then
    if [ "$(findmnt -n -o FSTYPE --target "$TMP_DIR" 2>/dev/null)" = "tmpfs" ]; then
      log "  ($TMP_DIR is emptied by the restart)"
    else
      find "$TMP_DIR" -mindepth 1 -maxdepth 1 ! -name 'systemd-private-*' ! -name '.X11-unix' ! -name '.ICE-unix' ! -name '.XIM-unix' ! -name '.font-unix' -exec rm -rf --one-file-system -- {} + || { log "  ERROR: could not empty $TMP_DIR."; RESET_ERRORS=$((RESET_ERRORS + 1)); }
    fi
  fi

  log "  EMPTY    $VARTMP_DIR"
  if [ "$mode" = "apply" ]; then
    find "$VARTMP_DIR" -mindepth 1 -maxdepth 1 ! -name 'systemd-private-*' ! -name '.X11-unix' ! -name '.ICE-unix' ! -name '.XIM-unix' ! -name '.font-unix' -exec rm -rf --one-file-system -- {} + || { log "  ERROR: could not empty $VARTMP_DIR."; RESET_ERRORS=$((RESET_ERRORS + 1)); }
  fi

  return 0
}

# Real run (Steps 5b-5d): all 8 steps.
reset_system_run() {
  local mode="${1:-reset}"
  if ! command -v ostree >/dev/null 2>&1; then   # check before changing anything
    log "ERROR: ostree not found."
    exit 3
  fi
  if [ "$mode" != "wipe" ]; then
    if ! confirm "System Reset puts ForgeOS system settings back to factory. Your personal files are kept. Continue?"; then
      log "Cancelled — nothing was changed."
      exit 0
    fi
  fi

  RESET_BK="$RESET_BK_DIR/$STAMP"
  mkdir -p "$RESET_BK"
  chmod 700 "$RESET_BK_DIR" "$RESET_BK"

  log "System Reset started. Backup folder: $RESET_BK"

  log "1. Scan first (threats in personal files get quarantined)."
  local scan_rc=0
  scan_steps || scan_rc=$?
  if [ "$scan_rc" -eq 3 ]; then
    log "  WARNING: the scan had a tool error (see the log) — reset continues."
    RESET_ERRORS=$((RESET_ERRORS + 1))
  elif [ "$scan_rc" -eq 1 ] || [ "$scan_rc" -eq 2 ]; then
    log "  Threats or tampering found — handled above; the reset continues."
  fi

  log "2. rpm-ostree reset (removes added packages and overrides)."
  if command -v rpm-ostree >/dev/null 2>&1; then
    if ! rpm-ostree reset >>"$LOG_FILE" 2>&1; then
      log "  WARNING: rpm-ostree reset failed (see the log)."
      RESET_ERRORS=$((RESET_ERRORS + 1))
    fi
  else
    log "  WARNING: rpm-ostree not found — skipped."
    RESET_ERRORS=$((RESET_ERRORS + 1))
  fi

  reset_etc_plan apply || exit 3
  reset_keep_warnings

  if [ "$mode" = "wipe" ]; then
    log "4. (skipped — personal folders are erased in Part 2)"
  else
    log "4. Clean each user's startup spots (personal files untouched):"
    reset_users_plan apply
  fi

  log "5. Clear hiding spots:"
  reset_clears apply

  log "6. Re-check apps:"
  if command -v flatpak >/dev/null 2>&1; then
    if ! flatpak repair --system >>"$LOG_FILE" 2>&1; then
      log "  WARNING: flatpak repair --system failed (see the log)."
      RESET_ERRORS=$((RESET_ERRORS + 1))
    fi
    if ! flatpak update -y --noninteractive >>"$LOG_FILE" 2>&1; then
      log "  WARNING: flatpak update -y --noninteractive failed (see the log)."
      RESET_ERRORS=$((RESET_ERRORS + 1))
    fi
  else
    log "  (flatpak not installed — skipped)"
  fi

  log "7. Fresh signed system image:"
  reset_image_ref
  if [ -z "$RESET_REF" ]; then
    log "  WARNING: no signed image reference found — skipped."
    RESET_ERRORS=$((RESET_ERRORS + 1))
  else
    local img_cmd=(rpm-ostree rebase "$RESET_REF")
    if [ "$RESET_SAME_REF" -eq 1 ]; then img_cmd=(rpm-ostree upgrade); fi   # rebase to the same ref fails
    if "${img_cmd[@]}" >>"$LOG_FILE" 2>&1; then
      log "  Fresh verified ForgeOS image staged for the next restart."
    else
      log "  WARNING: could not get a fresh image (no internet?). The reset still takes effect after the restart."
      RESET_ERRORS=$((RESET_ERRORS + 1))
    fi
  fi

  log "Done: $RESET_RESTORE restored, $RESET_REMOVE removed, $RESET_PUTBACK put back, $RESET_KEEP kept, $RESET_USERFILES user startup items, $RESET_ERRORS problems. Changes take effect after a restart."
  if [ "$mode" = "wipe" ]; then
    return 0
  fi

  log "8. Restart:"
  if [ "$YES" -eq 1 ]; then
    # No reboot here — the Clean Sweep window handles it (Step 7).
    log "  Restart the computer to finish."
  else
    if confirm "Restart now to finish the reset?"; then
      log "  Restarting..."
      systemctl reboot
    else
      log "  Restart the computer later to finish."
    fi
  fi

  if [ "$RESET_ERRORS" -gt 0 ]; then
    exit 3
  fi
  exit 0
}

# Shared reset plan (Step 6a): steps 1-7, printed by both reset-system and
# full-wipe. mode "wipe" skips step 4 — the homes are erased in Part 2 anyway.
reset_system_plan() {
  local mode="${1:-reset}"

  log "1. Scan first (threats in personal files get quarantined)."
  log "2. rpm-ostree reset (removes added packages and overrides)."
  reset_etc_plan || exit 3
  reset_keep_warnings

  if [ "$mode" = "wipe" ]; then
    log "4. (skipped — personal folders are erased in Part 2)"
  else
    log "4. Clean each user's startup spots (personal files untouched):"
    reset_users_plan
  fi

  log "5. Clear hiding spots:"
  reset_clears

  log "6. Re-check apps:"
  if command -v flatpak >/dev/null 2>&1; then
    log "  flatpak repair --system, then flatpak update -y"
  else
    log "  (flatpak not installed — skipped)"
  fi

  log "7. Fresh signed system image:"
  reset_image_ref
  if [ -n "$RESET_REF" ]; then
    if [ "$RESET_SAME_REF" -eq 1 ]; then
      log "  UPGRADE  $RESET_REF (already on the signed image; no update = keep the current one)"
    else
      log "  REBASE   $RESET_REF"
    fi
  else
    log "  WARNING: no signed image reference found — this step will be skipped."
  fi
}

# `forgeos-cleansweep reset-system`: --dry-run prints the full plan; without it, all 8 steps run for real (Steps 5b-5d).
reset_system() {
  if [ "$DRY_RUN" -eq 0 ]; then
    reset_system_run
  fi

  log "System Reset plan (dry run — nothing will be changed). Personal files are kept."
  reset_system_plan

  log "8. Show the summary, then restart after you click OK."

  log "Summary: $RESET_RESTORE to restore, $RESET_REMOVE to remove, $RESET_PUTBACK to put back, $RESET_KEEP kept, $RESET_USERFILES user startup items."
  : "$YES"   # YES is used in Step 5b; keeps shellcheck quiet
  exit 0
}

# Full Wipe Part 2 (Steps 6a/6c): list every regular user's home that would be
# erased and recreated from /etc/skel; mode "apply" really erases it. Only real
# folders under /home or /var/home are touched (checked by text AND by realpath)
# — symlinks and other paths are skipped with a note.
wipe_users_plan() {
  local mode="${1:-plan}"
  local user uid home size real

  while IFS=: read -r user _ uid _ _ home _; do
    case "$uid" in
      ''|*[!0-9]*) continue ;;   # not a numeric UID — skip (e.g. empty line)
    esac
    if [ "$uid" -lt 1000 ] || [ "$uid" -ge 60000 ]; then continue; fi

    if [ -L "$home" ]; then
      log "  SKIP     $user  $home (home is a symlink — not erased)"
      continue
    fi
    [ -d "$home" ] || continue

    case "$home" in
      /home/?*|/var/home/?*) ;;
      *) log "  SKIP     $user  $home (not under /home — not erased)"; continue ;;
    esac

    real="$(realpath -e -- "$home" 2>/dev/null)" || real=""
    case "$real" in
      /home/?*|/var/home/?*) ;;
      *) log "  SKIP     $user  $home (real path is outside /home — not erased)"; continue ;;
    esac
    # du exits 1 if anything inside is unreadable (e.g. a FUSE mount) — still show a size
    size="$( { du -sh -x -- "$home" 2>/dev/null || true; } | cut -f1)"
    [ -n "$size" ] || size="?"
    log "  ERASE    $user  $home ($size) → fresh copy of /etc/skel"
    WIPE_USERS=$((WIPE_USERS + 1))
    if [ "$mode" = "apply" ]; then
      if ! find "$real" -mindepth 1 -maxdepth 1 -exec rm -rf --one-file-system -- {} + 2>>"$LOG_FILE"; then
        log "    WARNING: could not erase everything in $real (see the log)."
        WIPE_ERRORS=$((WIPE_ERRORS + 1))
        continue
      fi
      # Copy as the user without -a: new files get the user as owner and the normal
      # home-folder SELinux label (cp -a would try to keep /etc/skel's label).
      if ! runuser -u "$user" -- cp -R --preserve=mode,timestamps -- /etc/skel/. "$real/" >>"$LOG_FILE" 2>&1; then
        log "    WARNING: could not copy /etc/skel into $real (see the log)."
        WIPE_ERRORS=$((WIPE_ERRORS + 1))
      fi
      if ! add_password_reminder "$user" "$real" >>"$LOG_FILE" 2>&1; then
        log "    WARNING: could not add the password reminder for $user (see the log)."
        WIPE_ERRORS=$((WIPE_ERRORS + 1))
      fi
    fi
  done < <(getent passwd)

  return 0
}

# Real run (Steps 6b-6c): two confirmations, then Part 1 (System Reset),
# Part 2 (erase homes), Part 3 (empty quarantine), Part 4 (restart).
full_wipe_run() {
  local word=""
  if ! command -v ostree >/dev/null 2>&1; then   # check before changing anything
    log "ERROR: ostree not found."
    exit 3
  fi
  if ! confirm "Full Wipe ERASES all personal files, apps and settings for every user, then resets ForgeOS to factory. This cannot be undone. Continue?"; then
    log "Cancelled — nothing was changed."
    exit 0
  fi
  if [ "$YES" -ne 1 ]; then
    read -r -p "Type WIPE to erase everything: " word
    if [ "$word" != "WIPE" ]; then
      log "Cancelled — nothing was changed."
      exit 0
    fi
  fi
  log "Full Wipe started."
  log "Part 1 — System Reset:"
  reset_system_run wipe
  log "Part 2 — Erase personal files:"
  wipe_users_plan apply
  log "Part 3 — Empty the quarantine:"
  if [ ! -d "$QUAR_DIR" ]; then
    log "  Quarantine is already empty."
  elif find "$QUAR_DIR" -mindepth 1 -delete 2>>"$LOG_FILE"; then
    log "  Quarantine emptied."
  else
    log "  WARNING: could not empty the quarantine (see the log)."
    WIPE_ERRORS=$((WIPE_ERRORS + 1))
  fi
  log "Wipe done: $WIPE_USERS personal folders erased, $((RESET_ERRORS + WIPE_ERRORS)) problems."
  log "Part 4 — Restart:"
  if [ "$YES" -eq 1 ]; then
    # No reboot here — the Clean Sweep window handles it (Step 7).
    log "  Restart the computer to finish."
  else
    if confirm "Restart now to finish the wipe?"; then
      log "  Restarting..."
      systemctl reboot
    else
      log "  Restart the computer later to finish."
    fi
  fi
  if [ $((RESET_ERRORS + WIPE_ERRORS)) -gt 0 ]; then
    exit 3
  fi
  exit 0
}

# `forgeos-cleansweep full-wipe` (Step 6a): the plan for erasing everything.
# A non-dry-run call goes to full_wipe_run (Step 6b).
full_wipe() {
  if [ "$DRY_RUN" -eq 0 ]; then
    full_wipe_run
  fi

  local qcount

  log "Full Wipe plan (dry run — nothing will be changed). ALL personal files, apps and settings will be ERASED."
  log "Part 1 — System Reset:"
  reset_system_plan wipe
  log "Part 2 — Erase personal files:"
  wipe_users_plan
  log "Part 3 — Empty the quarantine:"
  # -mindepth 2: files live in per-scan sub-folders; quarantine.log itself is not counted
  qcount="$(find "$QUAR_DIR" -mindepth 2 -type f 2>/dev/null | wc -l)"
  log "  DELETE   $qcount quarantined files (for good)"
  log "Part 4 — Restart after you click OK."
  log "Summary: $WIPE_USERS personal folders to erase, $qcount quarantined files to delete, $RESET_RESTORE to restore, $RESET_REMOVE to remove, $RESET_PUTBACK to put back."
  exit 0
}

usage() {
  cat >&2 <<'EOF'
Usage: forgeos-cleansweep [scan [--dry-run] | quarantine list|restore|delete ... | reset-system [--dry-run] [--yes] | full-wipe [--dry-run | --yes WIPE]]

Commands:
  scan          Check for threats: core check, ClamAV, rkhunter, chkrootkit, startup audit
  --dry-run     Scan but move nothing
  quarantine list                    List quarantined files (ID, date, threat, original location)
  quarantine restore <id> [--yes]    Put a quarantined file back
  quarantine delete <id|all> [--yes] Delete a quarantined file for good
  reset-system [--dry-run] [--yes]   Put the system back to factory; keeps personal files
  full-wipe [--dry-run | --yes WIPE] ERASE all personal files, then reset (asks twice)
  --yes         Skip the question — used by the Clean Sweep window
  (no command), -h, --help  Show this help

Exit codes: 0 = clean, 1 = threats quarantined, 2 = system tampering found, 3 = tool error.
EOF
}

# Argument parsing (Step 4a): the FIRST argument picks the command.
#   (no args) / -h / --help / help -> show usage, exit 0 (Step 7d)
#   scan [--dry-run]     -> scan; --dry-run alone means "scan, move nothing"
#   quarantine list      -> list what is locked away
#   quarantine restore <id> [--yes] / delete <id|all> [--yes]  (Step 4b)
#   reset-system [--dry-run] [--yes]  (Step 5a-1)
#   full-wipe [--dry-run | --yes WIPE]  (Step 6a)
QSUB=""    # quarantine sub-command: list | restore | delete
QID=""     # quarantined file id for restore/delete
RESET_RESTORE=0   # reset-system plan counters (Step 5a-1): files to restore / remove / put back
RESET_REMOVE=0
RESET_PUTBACK=0
RESET_KEEP=0      # kept files
RESET_FLAGS=0     # keep-list warnings found
RESET_USERFILES=0 # user startup items to move or reset (Step 5a-2)
RESET_REF=""      # signed image reference for the rebase step (Step 5a-2)
RESET_SAME_REF=0  # 1 = booted image is already RESET_REF -> rpm-ostree upgrade (Step 5d)
RESET_ERRORS=0    # problems found during a real reset run (Step 5b)
RESET_BK=""       # backup folder for this reset run, set in Step 5b
WIPE_USERS=0    # personal folders to erase (Step 6a)
WIPE_ERRORS=0    # problems during a real wipe (Step 6c)
F_DATE=""   # matched quarantine.log line (set by quarantine_find, Step 4b-1)
F_ORIG=""
F_SHA=""
F_THREAT=""
F_MOVED=""
F_MODE=""
F_OWNER=""
CMD=""
case "${1:-}" in
  ""|-h|--help|help) usage 2>&1; exit 0 ;;   # asked for help -> stdout
  scan)
    if [ "$#" -gt 2 ]; then usage; exit 3; fi
    case "${2:-}" in
      ""|--dry-run) : ;;
      *) usage; exit 3 ;;
    esac
    CMD="scan"
    if [ "${2:-}" = "--dry-run" ]; then DRY_RUN=1; fi
    ;;
  --dry-run)
    # "--dry-run" or "--dry-run scan" (older order still works)
    if [ "$#" -gt 2 ] || { [ "$#" -eq 2 ] && [ "$2" != "scan" ]; }; then usage; exit 3; fi
    CMD="scan"
    DRY_RUN=1
    ;;
  quarantine)
    case "${2:-}" in
      list)
        if [ "$#" -ne 2 ]; then usage; exit 3; fi
        QSUB="list"
        ;;
      restore|delete)
        if [ "$#" -lt 3 ] || [ "$#" -gt 4 ]; then usage; exit 3; fi
        QSUB="$2"
        QID="$3"
        if [ "$#" -eq 4 ]; then
          case "${4:-}" in
            --yes) YES=1 ;;
            *) usage; exit 3 ;;
          esac
        fi
        ;;
      *) usage; exit 3 ;;
    esac
    CMD="quarantine"
    ;;
  reset-system)
    # `reset-system [--dry-run] [--yes]` — flags in either order (Step 5a-1).
    if [ "$#" -gt 3 ]; then usage; exit 3; fi
    if [ "$#" -ge 2 ] && [ -z "$2" ]; then usage; exit 3; fi   # no empty flags
    case "${2:-}" in
      ""|--dry-run|--yes) : ;;
      *) usage; exit 3 ;;
    esac
    if [ "$#" -ge 3 ]; then
      case "${3:-}" in
        --dry-run|--yes) : ;;
        *) usage; exit 3 ;;
      esac
    fi
    CMD="reset"
    for flag in "${2:-}" "${3:-}"; do
      if [ "$flag" = "--dry-run" ]; then DRY_RUN=1; fi
      if [ "$flag" = "--yes" ]; then YES=1; fi
    done
    ;;
  full-wipe)
    # `full-wipe --dry-run` | `full-wipe` | `full-wipe --yes WIPE` (Step 6a)
    if [ "$#" -eq 1 ]; then :
    elif [ "$#" -eq 2 ] && [ "$2" = "--dry-run" ]; then DRY_RUN=1
    elif [ "$#" -eq 3 ] && [ "$2" = "--yes" ] && [ "$3" = "WIPE" ]; then YES=1
    else usage; exit 3; fi
    CMD="wipe"
    ;;
  *) usage; exit 3 ;;
esac

if [ "$(id -u)" -ne 0 ]; then
  echo "Clean Sweep must run as administrator." >&2
  exit 3
fi

mkdir -p "$LOG_DIR" "$QUAR_DIR"
chmod 700 "$QUAR_DIR"
LOG_FILE="${LOG_DIR}/clean-sweep-${STAMP}.log"

if [ "$CMD" = "scan" ]; then
  run_scan
elif [ "$CMD" = "quarantine" ]; then
  quarantine_cmd
elif [ "$CMD" = "reset" ]; then
  reset_system
elif [ "$CMD" = "wipe" ]; then
  full_wipe
fi
