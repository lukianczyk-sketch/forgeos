#!/usr/bin/env bash
# ForgeOS PC Report Card window (Job 21), a kdialog front end for forgeos-reportcard: the overall grade, each
# subject worst first (letter + color + one sentence), "what changed since last month", a button per subject
# that opens the ForgeOS tool that raises that grade, a PDF copy for a family helper, and past report cards.
# It never fixes anything itself.
set -uo pipefail

TITLE="PC Report Card"
ENGINE="${FORGEOS_CARD_ENGINE:-/usr/bin/forgeos-reportcard}"
TAB=$'\t'
BR="<br>"

if ! command -v kdialog >/dev/null 2>&1; then
  echo "kdialog is needed for this window. Use forgeos-reportcard report in a terminal." >&2
  exit 3
fi
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

info() { kdialog --title "$TITLE" --msgbox "$1" || true; }
esc() { sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g' <<< "$1"; }
color() { case "$1" in A|B) echo "#2e7d32" ;; C|D) echo "#b26a00" ;; F) echo "#c62828" ;; *) echo "#757575" ;; esac; }

grade_now() {
  kdialog --title "$TITLE" --passivepopup "Grading your PC... (a few seconds)" 6 >/dev/null 2>&1 &
  "$ENGINE" check > "$TMP/card" 2>/dev/null
  grep -q "^OVERALL${TAB}" "$TMP/card" && return 0
  printf 'OVERALL\t-\t-\tNot checked yet\tThe report card could not be made right now. Try again in a minute.\n' > "$TMP/card"
}

summary() {
  local g words why t key name sg why2 shown
  IFS="$TAB" read -r _ g _ words why < <(grep "^OVERALL${TAB}" "$TMP/card")
  t="<span style=\"font-size:x-large; color:$(color "$g")\"><b>Overall: $(esc "$g") - $(esc "$words")</b></span>${BR}$(esc "$why")${BR}"
  while IFS="$TAB" read -r _ key sg _ name _ _ why2; do
    case "$sg" in -) shown="$([ "$key" = passwords ] && echo "later" || echo "not checked")" ;; *) shown="$sg" ;; esac
    t+="${BR}<span style=\"color:$(color "$sg")\"><b>$(esc "$shown")</b></span> &nbsp;<b>$(esc "$name")</b> - $(esc "$why2")"
  done < <(grep "^SUBJECT${TAB}" "$TMP/card")
  grep -q "^CHANGE${TAB}" "$TMP/card" && t+="${BR}${BR}<i>$(esc "$(grep "^CHANGE${TAB}" "$TMP/card" | cut -f 2)")</i>"
  printf '%s' "$t"
}

open_tool() {
  local cmd
  case "$1" in  # only ForgeOS's own windows
    guard|tripwire|techguard|autopilot|drivehealth|undo|privacy|ghost|digitalwill|locate) cmd=("forgeos-$1-gui") ;;
    slow) cmd=(forgeos-slow-gui) ;;
    space) cmd=(forgeos-slow-gui --space) ;;
    *) return 0 ;;
  esac
  setsid "${cmd[@]}" >/dev/null 2>&1 < /dev/null &
}

save_copy() {
  local f
  f="$("$ENGINE" save 2>/dev/null | tail -n 1)"
  if [ -n "$f" ] && [ -s "$f" ]; then
    setsid xdg-open "$f" >/dev/null 2>&1 < /dev/null &
    info "Saved in Documents as $(esc "$(basename "$f")").${BR}${BR}It opens now - print it from there, or give the file to your family helper."
  else
    info "The copy could not be saved. Check that the Documents folder has room."
  fi
}

main_menu() {
  local pick items n key sg name button tool
  grade_now
  while true; do
    items=()
    n=0
    while IFS="$TAB" read -r _ key sg _ name button tool _; do
      n=$((n + 1)); [ "$sg" = - ] && sg="not checked"
      [ "$tool" = - ] || [ "$button" = - ] || items+=("open$n" "$name ($sg): $button")
    done < <(grep "^SUBJECT${TAB}" "$TMP/card")
    items+=(save "Save a copy for my family helper (PDF)" history "Past report cards" again "Grade again")
    pick="$(kdialog --title "$TITLE" --menu "$(summary)" "${items[@]}")" || return 0
    case "$pick" in
      open*) open_tool "$(grep "^SUBJECT${TAB}" "$TMP/card" | sed -n "${pick#open}p" | cut -f 7)" ;;
      save) save_copy ;;
      history) info "$(esc "$("$ENGINE" history 2>/dev/null)" | sed 's/$/<br>/')" ;;
      again) grade_now ;;
    esac
  done
}

case "${1:-}" in
  "") main_menu ;;
  *) echo "usage: forgeos-reportcard-gui" >&2; exit 3 ;;
esac
