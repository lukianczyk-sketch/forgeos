# ForgeOS — Scam Shield (Job 8): downloads the free lists of known scam websites. Started by forgeos-scamshield-update.timer.
# Only downloads lists. Nothing about you or what you check is ever sent.
[Unit]
Description=ForgeOS Scam Shield: download the lists of known scam websites
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/libexec/forgeos-scamshield-update
StateDirectory=forgeos-scamshield
StateDirectoryMode=0755
Nice=19
IOSchedulingClass=idle
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
NoNewPrivileges=yes
